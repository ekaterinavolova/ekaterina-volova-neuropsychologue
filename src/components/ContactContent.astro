---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cabinetHref = getLocalizedPath("/cabinet", lang);
---

{/* ─────────── HERO ─────────── */}
<header class="bg-[var(--color-paper)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 pt-10 sm:pt-14 pb-20 sm:pb-24">

    <p class="font-sans text-[0.8125rem] sm:text-sm uppercase tracking-[0.14em] text-[var(--color-accent)] mb-12 sm:mb-16">
      {t("nav.contact")}
    </p>

    <div class="max-w-[52rem]">
      <h1
        class="font-serif italic text-[var(--color-ink)] leading-[0.98] tracking-[-0.025em]"
        style="font-size: clamp(2.75rem, 6vw + 1rem, 5.5rem);"
      >
        {t("cta.contact")}
      </h1>
    </div>
  </div>
</header>

{/* ─────────── 01 — Coordonnees ─────────── */}
<section id="coordonnees" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          01
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <ul class="space-y-8">
          {/* Telephone */}
          <li class="flex items-center gap-5">
            <span class="w-10 h-10 rounded-full bg-[var(--color-accent-deep)] inline-flex items-center justify-center text-white shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
                {lang === "ru" ? "Телефон" : lang === "en" ? "Phone" : "Telephone"}
              </p>
              <a href="tel:+33666074254" class="font-serif text-xl text-[var(--color-ink)] no-underline hover:text-[var(--color-accent-deep)] transition-colors">
                06 66 07 42 54
              </a>
            </div>
          </li>

          {/* Email */}
          <li class="flex items-center gap-5">
            <span class="w-10 h-10 rounded-full bg-[var(--color-accent-deep)] inline-flex items-center justify-center text-white shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
                Email
              </p>
              <a href="mailto:volova.neuropsy@gmail.com" class="font-serif text-xl text-[var(--color-ink)] no-underline hover:text-[var(--color-accent-deep)] transition-colors">
                volova.neuropsy@gmail.com
              </a>
            </div>
          </li>

          {/* Doctolib */}
          <li class="flex items-center gap-5">
            <span class="w-10 h-10 rounded-full bg-[var(--color-accent-deep)] inline-flex items-center justify-center text-white shrink-0">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
                Doctolib
              </p>
              <p class="font-serif text-lg text-[var(--color-ink-muted)] italic">
                {lang === "ru" ? "Скоро" : lang === "en" ? "Coming soon" : "Bientot disponible"}
              </p>
            </div>
          </li>

          {/* Adresse */}
          <li class="flex items-start gap-5">
            <span class="w-10 h-10 rounded-full bg-[var(--color-accent-deep)] inline-flex items-center justify-center text-white shrink-0 mt-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                <circle cx="12" cy="10" r="3" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
                {lang === "ru" ? "Адрес" : lang === "en" ? "Address" : "Adresse"}
              </p>
              <address class="not-italic font-serif text-xl text-[var(--color-ink)] leading-relaxed">
                14 rue Nicolo<br />
                75116 Paris
              </address>
              <a
                href={cabinetHref}
                class="mt-2 inline-flex items-baseline gap-2 font-sans text-[0.8125rem] text-[var(--color-accent-deep)] no-underline hover:underline"
              >
                <span>{lang === "ru" ? "Как добраться" : lang === "en" ? "How to get there" : "Comment s'y rendre"}</span>
                <span>&#8594;</span>
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 02 — Horaires ─────────── */}
<section id="horaires" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          02
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("cabinet.hours_label")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <p class="font-serif text-xl text-[var(--color-ink-soft)] leading-relaxed">
          {t("cabinet.hours")}
        </p>
        <p class="mt-6 font-serif italic text-[var(--color-ink-muted)]">
          {t("footer.opening_note")}
        </p>

        <div class="mt-10 pt-8 border-t border-[var(--color-rule-soft)]">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-3">
            {t("cabinet.reimbursement_label")}
          </p>
          <p class="font-serif text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("cabinet.reimbursement")}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
