---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import Container from "./Container.astro";
import Section from "./Section.astro";
import Ornament from "./Ornament.astro";
import Button from "./Button.astro";
import CabinetMap from "./CabinetMap.astro";
import TransportBadges from "./TransportBadges.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const email = "volova.neuropsy@gmail.com";
const inputClass =
  "w-full border border-[var(--color-rule)] bg-[var(--color-paper)] rounded-[var(--radius-md)] px-3 py-2 text-[var(--color-ink)] focus:outline-none focus:border-[var(--color-accent-deep)] transition-colors";

// Cle publique Turnstile (anti-spam). En local, cle de test Cloudflare "toujours valide".
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "1x00000000000000000000AA";
---

<Section tone="paper" spacing="normal" as="header" class="!pt-12 !pb-0">
  <Container width="content">
    <h1 class="font-serif italic text-center text-[clamp(1.75rem,2vw_+_1rem,2.5rem)]">{t("contact.heading")}</h1>
  </Container>
</Section>

{/* Coordonnées */}
<Section tone="paper" spacing="normal" as="section" class="!pt-12 !pb-0">
  <Container width="content">
    <div class="max-w-[50rem] mx-auto flex flex-col items-center justify-center gap-10">
      <div class="w-full flex flex-col md:flex-row-reverse md:items-stretch justify-center gap-8 md:gap-10">
      <img
        src="/images/cabinet.jpg"
        alt={t("contact.photo_alt")}
        width="1400"
        height="1867"
        loading="lazy"
        class="w-full md:w-[19rem] shrink-0 h-auto md:h-full md:object-cover rounded-[var(--radius-md)] border border-[var(--color-rule)]"
      />

      <div class="flex flex-col items-center md:items-start gap-6">
      <div class="flex flex-col items-center md:items-start gap-4 text-[var(--color-ink-soft)]">
        <div class="flex items-center gap-2.5">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-accent-deep)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          <address class="not-italic font-semibold text-[var(--color-ink)]">{t("footer.office_address")}</address>
        </div>
        <a href="tel:+33666074254" class="flex items-center gap-2.5 hover:text-[var(--color-ink)] transition-colors">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-accent-deep)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          +33 6 66 07 42 54
        </a>
        <a href={`mailto:${email}`} class="flex items-center gap-2.5 hover:text-[var(--color-ink)] transition-colors">
          <svg class="w-4 h-4 shrink-0 text-[var(--color-accent-deep)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
          </svg>
          {email}
        </a>
      </div>

      <TransportBadges />
      </div>
      </div>

      <CabinetMap />
    </div>
  </Container>
</Section>

{/* Question */}
<Section tone="paper" spacing="normal" as="section" class="!pt-0 !pb-8">
  <Container width="content">
    <Ornament tone="accent" spacing="sm" class="!my-12" />
    <h2 class="font-serif italic text-center text-lg sm:text-xl text-[var(--color-ink-soft)]">{t("contact.form_heading")}</h2>
    <p class="mt-4 max-w-[34rem] mx-auto text-center text-sm text-[var(--color-ink-muted)] leading-relaxed">{t("contact.form_intro")}</p>

    <form
      id="question-form"
      class="mt-8 max-w-[34rem] mx-auto flex flex-col gap-4"
      data-msg-sending={t("contact.sending")}
      data-msg-success={t("contact.success")}
      data-msg-error={t("contact.error")}
    >
      <label class="flex flex-col gap-1.5 text-sm text-[var(--color-ink-soft)]">
        {t("contact.name")}
        <input type="text" name="name" required maxlength="200" class={inputClass} />
      </label>
      <label class="flex flex-col gap-1.5 text-sm text-[var(--color-ink-soft)]">
        {t("contact.email")}
        <input type="email" name="email" required maxlength="320" class={inputClass} />
      </label>
      <label class="flex flex-col gap-1.5 text-sm text-[var(--color-ink-soft)]">
        {t("contact.message")}
        <textarea name="message" rows="5" required maxlength="5000" class={`${inputClass} resize-y`}></textarea>
      </label>
      {/* Honeypot anti-spam : invisible pour un humain, rempli par les bots */}
      <div class="hidden" aria-hidden="true">
        <label>
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <div class="flex justify-center">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
      </div>
      <div class="mt-2 text-center">
        <Button type="submit" variant="primary">{t("contact.send")}</Button>
      </div>
      <p id="form-status" class="hidden text-center text-sm leading-relaxed" role="status"></p>
    </form>
  </Container>
</Section>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById("question-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  function showStatus(text: string, kind: "info" | "success" | "error") {
    if (!status) return;
    status.textContent = text;
    status.classList.remove("hidden", "text-[var(--color-ink-muted)]", "text-[var(--color-accent-deep)]", "text-red-700");
    status.classList.add(
      kind === "success"
        ? "text-[var(--color-accent-deep)]"
        : kind === "error"
          ? "text-red-700"
          : "text-[var(--color-ink-muted)]",
    );
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = (data.get("name") || "").toString().trim();
      const visitorEmail = (data.get("email") || "").toString().trim();
      const message = (data.get("message") || "").toString().trim();
      const website = (data.get("website") || "").toString().trim();
      const turnstileToken = (data.get("cf-turnstile-response") || "").toString();

      const submitBtn = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (submitBtn) submitBtn.disabled = true;
      showStatus(form.dataset.msgSending || "...", "info");

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, email: visitorEmail, message, website, turnstileToken }),
        });
        const result = await res.json();
        if (!result.ok) throw new Error(result.error || "send_failed");

        form.reset();
        (window as any).turnstile?.reset();
        showStatus(form.dataset.msgSuccess || "OK", "success");
      } catch {
        // Fallback : ouverture du logiciel de messagerie du visiteur,
        // son message pre-rempli (rien n'est perdu).
        showStatus(form.dataset.msgError || "Erreur", "error");
        const subject = encodeURIComponent("Question via le site - " + name);
        const body = encodeURIComponent(message + "\n\n--\n" + name + "\n" + visitorEmail);
        window.location.href = "mailto:volova.neuropsy@gmail.com?subject=" + subject + "&body=" + body;
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>
