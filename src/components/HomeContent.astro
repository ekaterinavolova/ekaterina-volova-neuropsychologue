---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";
import { Image } from "astro:assets";
import portraitEkaterina from "~/assets/portrait-ekaterina.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    title: t("home.services.s0_title"),
    desc: t("home.services.s0_desc"),
    price: t("home.services.s0_price"),
  },
  {
    title: t("home.services.s1_title"),
    desc: t("home.services.s1_desc"),
    price: t("home.services.s1_price"),
  },
  {
    title: t("home.services.s2_title"),
    desc: t("home.services.s2_desc"),
    price: t("home.services.s2_price"),
  },
  {
    title: t("home.services.s3_title"),
    desc: t("home.services.s3_desc"),
    price: t("home.services.s3_price"),
  },
  {
    title: t("home.services.s4_title"),
    desc: t("home.services.s4_desc"),
    price: t("home.services.s4_price"),
    note: t("home.services.note_supervised"),
  },
];

const processSteps = [
  { title: t("home.process.step1_title"), desc: t("home.process.step1_desc") },
  { title: t("home.process.step2_title"), desc: t("home.process.step2_desc") },
  { title: t("home.process.step3_title"), desc: t("home.process.step3_desc") },
  { title: t("home.process.step4_title"), desc: t("home.process.step4_desc") },
];

type CabinetLabels = {
  roomTitle: string;
  entryTitle: string;
  accessTitle: string;
  metro: string;
  bus: string;
  pmr: string;
  metroStation: string;
  metroTime: string;
  metro9Station: string;
  metro9Time: string;
  busStop: string;
  busTime: string;
  bus52Stop: string;
  bus52Time: string;
  parking: string;
  parkingName: string;
  parkingTime: string;
  parking2Name: string;
  parking2Time: string;
  parking2Note: string;
  velib: string;
  velibStation: string;
  velibTime: string;
  onSiteTitle: string;
  onSiteInterphone: string;
  onSiteDirections: string;
  pmrValue: string;
};

const cabinetLabels: Record<string, CabinetLabels> = {
  fr: {
    roomTitle: "Salle de bilan",
    entryTitle: "Entrée du cabinet",
    accessTitle: "Accès",
    metro: "Métro",
    bus: "Bus",
    pmr: "Accessibilité",
    metroStation: "Passy",
    metroTime: "450 m",
    metro9Station: "La Muette",
    metro9Time: "500 m",
    busStop: "arrêt Jean Bologne",
    busTime: "50 m",
    bus52Stop: "arrêt La Muette-Boulainvilliers",
    bus52Time: "450 m",
    parking: "Parking",
    parkingName: "19 rue de Passy",
    parkingTime: "250 m",
    parking2Name: "Indigo Passy, 80 rue de Passy",
    parking2Time: "500 m",
    parking2Note: "24h/24",
    velib: "Vélib'",
    velibStation: "Passy - Place du Costa Rica",
    velibTime: "300 m",
    onSiteTitle: "Sur place",
    onSiteInterphone: "Interphone « Ekaterina Volova »",
    onSiteDirections: "A gauche après la porte d'entrée, seconde porte après le hall.",
    pmrValue: "Cabinet en rez-de-chaussée, accessible PMR",
  },
  ru: {
    roomTitle: "Зал обследования",
    entryTitle: "Вход в кабинет",
    accessTitle: "Доступ",
    metro: "Метро",
    bus: "Автобус",
    pmr: "Доступность",
    metroStation: "Passy",
    metroTime: "450 м",
    metro9Station: "La Muette",
    metro9Time: "500 м",
    busStop: "остановка Jean Bologne",
    busTime: "50 м",
    bus52Stop: "остановка La Muette-Boulainvilliers",
    bus52Time: "450 м",
    parking: "Парковка",
    parkingName: "19 rue de Passy",
    parkingTime: "250 м",
    parking2Name: "Indigo Passy, 80 rue de Passy",
    parking2Time: "500 м",
    parking2Note: "24ч/24ч",
    velib: "Vélib'",
    velibStation: "Passy - Place du Costa Rica",
    velibTime: "300 м",
    onSiteTitle: "На месте",
    onSiteInterphone: "Домофон « Ekaterina Volova »",
    onSiteDirections: "Налево после входной двери, вторая дверь после холла.",
    pmrValue: "Кабинет на первом этаже, доступен для МГН",
  },
  en: {
    roomTitle: "Assessment room",
    entryTitle: "Entrance",
    accessTitle: "Access",
    metro: "Metro",
    bus: "Bus",
    pmr: "Accessibility",
    metroStation: "Passy",
    metroTime: "450 m",
    metro9Station: "La Muette",
    metro9Time: "500 m",
    busStop: "Jean Bologne stop",
    busTime: "50 m",
    bus52Stop: "La Muette-Boulainvilliers stop",
    bus52Time: "450 m",
    parking: "Parking",
    parkingName: "19 rue de Passy",
    parkingTime: "250 m",
    parking2Name: "Indigo Passy, 80 rue de Passy",
    parking2Time: "500 m",
    parking2Note: "24/7",
    velib: "Vélib'",
    velibStation: "Passy - Place du Costa Rica",
    velibTime: "300 m",
    onSiteTitle: "On site",
    onSiteInterphone: "Intercom 'Ekaterina Volova'",
    onSiteDirections: "Turn left after the entrance door, second door past the hall.",
    pmrValue: "Ground-floor practice, wheelchair accessible",
  },
};

const cab = cabinetLabels[lang] ?? cabinetLabels.fr;

const contactHref = getLocalizedPath("/contact", lang);
const aboutHref = getLocalizedPath("/a-propos", lang);
---

{/* ─────────── HERO ─────────── */}
<header class="hero-bg flex flex-col items-center justify-center text-center relative" style="min-height: calc(100vh - 4.5rem);">
  <div class="absolute inset-6 sm:inset-10 border border-white/10 pointer-events-none"></div>
  <div class="px-6 sm:px-8 py-20 sm:py-28 w-full flex flex-col items-center relative z-10">

    {/* Monogramme */}
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80" class="w-24 h-24 sm:w-32 sm:h-32" aria-hidden="true">
      <g fill="white" stroke="none">
        <rect x="4" y="4" width="72" height="72" fill="none" stroke="white" stroke-width="1.2" />
        <rect x="8" y="8" width="64" height="64" fill="none" stroke="white" stroke-width="0.4" />
        <rect x="15" y="20" width="4" height="40" />
        <polygon points="13,20 15,20 15,21.2 13,21.2" />
        <polygon points="13,58.8 15,58.8 15,60 13,60" />
        <rect x="15" y="20" width="17" height="1" />
        <polygon points="32,20 32,22.5 31,22.5" />
        <rect x="15" y="39.5" width="13.5" height="0.9" />
        <rect x="15" y="59" width="17.5" height="1" />
        <polygon points="32.5,57.5 32.5,60 31.5,60" />
        <circle cx="39" cy="40" r="1.8" />
        <polygon points="46,20 50,20 57.5,60 54.5,60" />
        <polygon points="66,20 67.2,20 58.5,60 57,60" />
        <polygon points="44,20 46,20 46,21.2 44,21.2" />
        <rect x="46" y="20" width="5" height="1" />
        <rect x="64" y="20" width="5" height="1" />
        <polygon points="67.2,20 69,20 69,21.2 67.2,21.2" />
      </g>
    </svg>

    {/* Profession */}
    <p class="mt-6 sm:mt-8 font-serif small-caps text-[0.9375rem] sm:text-[1.0625rem] tracking-[0.12em] text-white/90">
      {t("home.lede")}
    </p>

    {/* Nom */}
    <h1
      class="mt-4 sm:mt-5 font-serif text-white leading-[0.95] tracking-[-0.02em]"
      style="font-size: clamp(3.5rem, 9vw + 1rem, 8rem); font-weight: 300;"
    >
      {t("home.h1")}
    </h1>

    {/* Lieu */}
    <p class="mt-6 sm:mt-8 font-sans text-[0.75rem] sm:text-[0.8125rem] uppercase tracking-[0.25em] text-white/60">
      Paris XVI<sup class="text-[0.5rem]">e</sup>
      <span class="mx-3">&bull;</span>
      Sur rendez-vous
    </p>

    {/* CTA */}
    <a
      href={contactHref}
      class="mt-10 sm:mt-12 inline-block font-sans text-[0.875rem] font-semibold uppercase tracking-[0.18em] no-underline px-14 py-5 bg-white text-[#2E4A62] hover:bg-gray-100 transition-all duration-300"
    >
      {t("home.cta_primary")}
    </a>

  </div>
</header>

{/* ─────────── Post-hero intro ─────────── */}
<section class="bg-[var(--color-paper)]">
  <div class="mx-auto max-w-[var(--container-prose)] px-6 sm:px-8 py-20 sm:py-28 text-center">
    <h2 class="font-serif small-caps text-[var(--color-accent-deep)] tracking-[0.04em]"
        style="font-size: clamp(1.5rem, 2vw + 0.75rem, 2rem); font-weight: 400;">
      Ekaterina Volova
    </h2>
    <div class="flex justify-center my-8" aria-hidden="true">
      <svg width="64" height="12" viewBox="0 0 64 12" fill="none">
        <line x1="0" y1="6" x2="26" y2="6" stroke="var(--color-accent-deep)" stroke-width="0.5" opacity="0.4" />
        <circle cx="32" cy="6" r="2" fill="var(--color-accent-deep)" opacity="0.5" />
        <line x1="38" y1="6" x2="64" y2="6" stroke="var(--color-accent-deep)" stroke-width="0.5" opacity="0.4" />
      </svg>
    </div>
    <p class="font-serif text-[var(--color-ink-soft)] leading-[1.9]"
       style="font-size: clamp(1rem, 0.3vw + 0.9rem, 1.125rem);">
      {t("site.description")}
    </p>
    <p class="mt-8 font-sans text-[0.6875rem] uppercase tracking-[0.22em] text-[var(--color-ink-muted)]">
      Français
      <span class="mx-2 text-[var(--color-rule)]">&bull;</span>
      Русский
      <span class="mx-2 text-[var(--color-rule)]">&bull;</span>
      English
    </p>
  </div>
</section>

{/* ─────────── Portrait ─────────── */}
<section class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-content)] px-6 sm:px-8 py-16 sm:py-24">
    <div class="flex justify-center">
      <figure class="relative max-w-[22rem]">
        <div class="aspect-[3/4] w-full relative bg-[var(--color-paper-deep)] p-[18px]">
          <div class="absolute inset-[10px] border border-[var(--color-ink)]/10 pointer-events-none"></div>
          <div class="relative h-full w-full overflow-hidden">
            <Image
              src={portraitEkaterina}
              alt="Ekaterina Volova, psychologue spécialisée en neuropsychologie"
              widths={[400, 600, 900]}
              sizes="22rem"
              format="webp"
              quality={88}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
        <figcaption class="mt-4 font-sans text-[0.6875rem] uppercase tracking-[0.2em] text-[var(--color-ink-faint)] text-center">
          Pl. I
          <span class="mx-2.5 text-[var(--color-rule-soft)]">&mdash;</span>
          Ekaterina Volova
        </figcaption>
      </figure>
    </div>
  </div>
</section>

{/* ─────────── 02 — Pour qui ─────────── */}
<section id="who" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          02
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("home.who.title")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <p class="font-serif text-[1.375rem] sm:text-[1.5rem] leading-[1.45] text-[var(--color-ink)] tracking-[-0.012em]">
          {t("home.who.intro")}
        </p>

        <div class="mt-12 pt-10 border-t border-[var(--color-rule)]">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-5">
            {t("home.who.indications_title")}
          </p>
          <p
            class="font-sans text-[var(--color-ink-soft)] leading-[1.75]"
            style="text-align: justify; hyphens: auto;"
            lang={lang}
          >
            {t("home.who.indications")}
          </p>
        </div>

        <p class="mt-10 font-serif italic text-[var(--color-ink-muted)] text-[0.9375rem] leading-relaxed border-l-2 border-[var(--color-rule)] pl-5 text-justify">
          {t("home.who.note")}
        </p>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 03 — Quatre prestations ─────────── */}
<section id="services" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          03
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("home.services.title")}
        </p>
      </aside>

      <div>
        <ul class="divide-y divide-[var(--color-rule)] border-y border-[var(--color-rule)]">
          {services.map((s, idx) => (
            <li class="py-8 sm:py-10 grid gap-x-10 gap-y-3 sm:grid-cols-[3rem_minmax(0,1fr)_auto] items-baseline">
              <span class="font-serif italic text-[var(--color-ink-faint)] text-2xl tabular-nums">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="font-serif text-[var(--color-ink)] text-[1.375rem] tracking-[-0.012em]">
                  {s.title}
                </h3>
                <p class="mt-3 font-sans text-[var(--color-ink-soft)] leading-relaxed max-w-[36rem] text-justify">
                  {s.desc}
                </p>
                {s.note && (
                  <p class="mt-3 font-serif italic text-sm text-[var(--color-ink-muted)]">
                    {s.note}
                  </p>
                )}
              </div>
              <span class="font-sans text-sm tabular-nums text-[var(--color-accent-deep)] sm:text-right whitespace-nowrap">
                {s.price}
              </span>
            </li>
          ))}
        </ul>

        <div class="mt-14">
          <a
            href={contactHref}
            class="inline-block font-sans text-[0.8125rem] font-semibold uppercase tracking-[0.16em] no-underline px-10 py-4 transition-all duration-300 bg-[#3A5A72] text-white hover:bg-[#2E4A62]"
          >
            {t("home.cta_primary")}
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

{/* ─────────── 04 — Déroulé du bilan ─────────── */}
<section id="process" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          04
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("home.process.title")}
        </p>
      </aside>

      <ol class="space-y-12 max-w-[42rem]">
        {processSteps.map((step, idx) => (
          <li class="grid grid-cols-[4rem_minmax(0,1fr)] gap-6">
            <span class="font-serif italic text-3xl text-[var(--color-accent-deep)] tabular-nums leading-none pt-1">
              {String(idx + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-serif text-[1.25rem] text-[var(--color-ink)] tracking-[-0.01em]">
                {step.title}
              </h3>
              <p class="mt-2 font-sans text-[var(--color-ink-soft)] leading-relaxed text-justify">
                {step.desc}
              </p>
            </div>
          </li>
        ))}
      </ol>

      <div class="mt-14 md:col-start-2">
          <a
            href={contactHref}
            class="inline-block font-sans text-[0.8125rem] font-semibold uppercase tracking-[0.16em] no-underline px-10 py-4 transition-all duration-300 bg-[#3A5A72] text-white hover:bg-[#2E4A62]"
          >
            {t("home.cta_primary")}
          </a>
        </div>
    </div>
  </div>
</section>

{/* ─────────── 05 — Langues ─────────── */}
<section id="languages" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          05
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("home.languages.title")}
        </p>
      </aside>

      <dl class="max-w-[42rem] space-y-8">
        <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-x-8 gap-y-2 items-baseline border-b border-[var(--color-rule-soft)] pb-6">
          <dt class="font-serif italic text-2xl text-[var(--color-ink)]" lang="fr">Français</dt>
          <dd class="font-sans text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("home.languages.fr").replace(/^Français — /, "").replace(/^Français - /, "")}
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-x-8 gap-y-2 items-baseline border-b border-[var(--color-rule-soft)] pb-6">
          <dt class="font-serif italic text-2xl text-[var(--color-ink)]" lang="ru">Русский</dt>
          <dd class="font-sans text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("home.languages.ru").replace(/^Русский — /, "").replace(/^Русский - /, "")}
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-x-8 gap-y-2 items-baseline">
          <dt class="font-serif italic text-2xl text-[var(--color-ink)]" lang="en">English</dt>
          <dd class="font-sans text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("home.languages.en").replace(/^English — /, "").replace(/^English - /, "")}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

{/* ─────────── 06 — Cabinet ─────────── */}
<section id="cabinet" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          06
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("footer.cabinet_label")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        {/* Adresse */}
        <address class="not-italic font-serif text-[1.5rem] sm:text-[1.75rem] leading-[1.4] text-[var(--color-ink)] tracking-[-0.012em]">
          14 rue Nicolo<br />
          75116 Paris
        </address>
        <p class="mt-4 font-serif italic text-[var(--color-ink-muted)]">
          {t("footer.opening_note")}
        </p>

        {/* Horaires */}
        <div class="mt-6">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
            {t("cabinet.hours_label")}
          </p>
          <p class="mt-2 font-serif text-lg text-[var(--color-ink-soft)]">
            {t("cabinet.hours")}
          </p>
        </div>

        {/* Contact */}
        <div class="mt-6">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
            {t("cabinet.contact_label")}
          </p>
          <div class="mt-2 font-serif text-lg text-[var(--color-ink-soft)] space-y-1">
            <p>
              <a href="tel:+33666074254" class="no-underline text-[var(--color-ink)] hover:text-[var(--color-accent-deep)] transition-colors">
                06 66 07 42 54
              </a>
            </p>
            <p>
              <a href="mailto:volova.neuropsy@gmail.com" class="no-underline text-[var(--color-ink)] hover:text-[var(--color-accent-deep)] transition-colors">
                volova.neuropsy@gmail.com
              </a>
            </p>
          </div>
        </div>

        {/* Remboursement */}
        <div class="mt-6">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
            {t("cabinet.reimbursement_label")}
          </p>
          <p class="mt-2 font-serif text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("cabinet.reimbursement")}
          </p>
        </div>

        {/* Accès — pastilles RATP officielles + texte serif lisible */}
        <div class="mt-14 pt-10 border-t border-[var(--color-rule)]">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-8">
            {cab.accessTitle}
          </p>

          <ul class="space-y-6">

            {/* Accessibilité */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="w-9 h-9 rounded-full bg-[var(--color-accent-deep)] inline-flex items-center justify-center text-white translate-y-[0.15em]"
