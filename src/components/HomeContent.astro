---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";
import Container from "./Container.astro";
import Section from "./Section.astro";
import Button from "./Button.astro";
import Ornament from "./Ornament.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const bilanSteps = [
  {
    title: t("about.section2_step1_title"),
    desc: t("about.section2_step1_desc"),
  },
  {
    title: t("about.section2_step2_title"),
    desc: t("about.section2_step2_desc"),
  },
  {
    title: t("about.section2_step3_title"),
    desc: t("about.section2_step3_desc"),
  },
];

---

{/* Hero */}
<Section tone="paper" spacing="loose" as="header">
  <Container width="wide">
    <div class="grid gap-10 md:grid-cols-[22rem_1fr] md:gap-14 items-center">
      {/* Emplacement photo - à remplacer par <img> quand le portrait sera fourni */}
      <div
        class="aspect-[3/4] w-full max-w-[22rem] mx-auto md:mx-0 bg-[var(--color-paper-deep)] border border-[var(--color-rule-soft)] rounded-[var(--radius-sm)]"
        aria-hidden="true"
      ></div>

      <div>
        <h1 class="font-serif italic text-[var(--color-accent-deep)] md:whitespace-nowrap">{t("home.h1")}</h1>
        <div class="mt-6 flex items-center gap-4">
          <span class="block h-px w-6 bg-[var(--color-rose-deep)] shrink-0" aria-hidden="true"></span>
          <p class="font-serif italic text-lg sm:text-xl text-[var(--color-ink-soft)] leading-relaxed md:whitespace-nowrap">
            {t("home.lede")}
          </p>
          <span class="block h-px w-6 bg-[var(--color-rose-deep)] shrink-0" aria-hidden="true"></span>
        </div>
        <div class="mt-10">
          <Button href={getLocalizedPath("/contact", lang)} variant="secondary" size="lg">
            {t("home.cta_secondary")}
          </Button>
        </div>
      </div>
    </div>
  </Container>
</Section>

{/* Neuropsychologie + bilan */}
<Section tone="warm" spacing="normal" as="section" id="discipline">
  <Container width="content">
    <Ornament tone="rose" spacing="sm" class="!mt-0 !mb-12" />

    <h2 class="font-serif italic text-center text-lg sm:text-xl text-[var(--color-ink-soft)]">
      {t("about.section1_title")}
    </h2>

    <div class="mt-6 max-w-[44rem] mx-auto text-[var(--color-ink-soft)] leading-relaxed text-justify">
      <p>{t("about.section1_p1")}</p>
    </div>

    <h2 class="mt-10 font-serif italic text-center text-lg sm:text-xl text-[var(--color-ink-soft)]">
      {t("about.section2_title")}
    </h2>

    <div class="mt-6 max-w-[44rem] mx-auto space-y-6 text-[var(--color-ink-soft)] leading-relaxed text-justify">
      <p>{t("about.section2_p1")}</p>
    </div>

    <div class="mt-6 max-w-[44rem] mx-auto">
      <h3 class="font-serif italic text-base sm:text-lg tracking-tight text-[var(--color-ink)] mb-3">
        {t("about.section2_steps_intro")}
      </h3>
      <ol class="space-y-4">
        {bilanSteps.map((step, idx) => (
          <li class="grid grid-cols-[3rem_1fr] gap-6 items-baseline">
            <span class="font-serif italic text-3xl text-[var(--color-rose-deep)] tabular-nums">
              {idx + 1}
            </span>
            <div>
              <h3 class="font-serif text-base font-bold" set:html={step.title} />
              <p class="mt-2 text-[var(--color-ink-soft)] leading-relaxed text-justify">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</Section>




{/* Remédiation et stimulation cognitive */}
<Section tone="paper" spacing="normal" as="section">
  <Container width="content">
    <h2 class="font-serif italic text-center text-lg sm:text-xl text-[var(--color-ink-soft)]">
      {t("home.remediation.title")}
    </h2>
    <div class="mt-6 max-w-[44rem] mx-auto text-[var(--color-ink-soft)] leading-relaxed text-justify">
      <p>{t("home.remediation.desc")}</p>
    </div>
  </Container>
</Section>

{/* Contact */}
<Section tone="warm" spacing="normal" as="section" id="contact">
  <Container width="content">
    <Ornament tone="rose" spacing="sm" class="!mt-0 !mb-12" />
    <h2 class="font-serif italic text-center">{t("cta.contact")}</h2>

    <ul class="mt-10 space-y-6 max-w-[28rem] mx-auto">
      <li class="flex items-center gap-4">
        <svg class="w-5 h-5 shrink-0 text-[var(--color-accent-deep)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        <a href="tel:+33666074254" class="text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] no-underline">
          +33 6 66 07 42 54
        </a>
      </li>
      <li class="flex items-center gap-4">
        <svg class="w-5 h-5 shrink-0 text-[var(--color-accent-deep)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        <a href="mailto:volova.neuropsy@gmail.com" class="text-[var(--color-ink-soft)] hover:text-[var(--color-ink)] no-underline">
          volova.neuropsy@gmail.com
        </a>
      </li>
      <li class="flex items-start gap-4">
        <svg class="w-5 h-5 shrink-0 text-[var(--color-accent-deep)] mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
        <address class="not-italic text-[var(--color-ink-soft)] leading-relaxed">
          14 rue Nicolo<br />
          75116 Paris
        </address>
      </li>
    </ul>
    <Ornament tone="gold" spacing="md" class="!mb-0" />
  </Container>
</Section>
