---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";
import { Image } from "astro:assets";
import portraitEkaterina from "~/assets/portrait-ekaterina.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  {
    title: t("home.services.s0_title"),
    desc: t("home.services.s0_desc"),
    price: t("home.services.s0_price"),
  },
  {
    title: t("home.services.s1_title"),
    desc: t("home.services.s1_desc"),
    price: t("home.services.s1_price"),
  },
  {
    title: t("home.services.s2_title"),
    desc: t("home.services.s2_desc"),
    price: t("home.services.s2_price"),
  },
  {
    title: t("home.services.s3_title"),
    desc: t("home.services.s3_desc"),
    price: t("home.services.s3_price"),
  },
  {
    title: t("home.services.s4_title"),
    desc: t("home.services.s4_desc"),
    price: t("home.services.s4_price"),
    note: t("home.services.note_supervised"),
  },
];

const processSteps = [
  { title: t("home.process.step1_title"), desc: t("home.process.step1_desc") },
  { title: t("home.process.step2_title"), desc: t("home.process.step2_desc") },
  { title: t("home.process.step3_title"), desc: t("home.process.step3_desc") },
  { title: t("home.process.step4_title"), desc: t("home.process.step4_desc") },
];

type CabinetLabels = {
  roomTitle: string;
  entryTitle: string;
  accessTitle: string;
  metro: string;
  bus: string;
  pmr: string;
  metroStation: string;
  metroTime: string;
  metro9Station: string;
  metro9Time: string;
  busStop: string;
  busTime: string;
  bus52Stop: string;
  bus52Time: string;
  parking: string;
  parkingName: string;
  parkingTime: string;
  parking2Name: string;
  parking2Time: string;
  parking2Note: string;
  velib: string;
  velibStation: string;
  velibTime: string;
  onSiteTitle: string;
  onSiteInterphone: string;
  onSiteDirections: string;
  pmrValue: string;
};

const cabinetLabels: Record<string, CabinetLabels> = {
  fr: {
    roomTitle: "Salle de bilan",
    entryTitle: "Entrée du cabinet",
    accessTitle: "Accès",
    metro: "Métro",
    bus: "Bus",
    pmr: "Accessibilité",
    metroStation: "Passy",
    metroTime: "450 m",
    metro9Station: "La Muette",
    metro9Time: "500 m",
    busStop: "arrêt Jean Bologne",
    busTime: "50 m",
    bus52Stop: "arrêt La Muette-Boulainvilliers",
    bus52Time: "450 m",
    parking: "Parking",
    parkingName: "19 rue de Passy",
    parkingTime: "250 m",
    parking2Name: "Indigo Passy, 80 rue de Passy",
    parking2Time: "500 m",
    parking2Note: "24h/24",
    velib: "Vélib'",
    velibStation: "Passy - Place du Costa Rica",
    velibTime: "300 m",
    onSiteTitle: "Sur place",
    onSiteInterphone: "Interphone « Ekaterina Volova »",
    onSiteDirections: "A gauche après la porte d'entrée, seconde porte après le hall.",
    pmrValue: "Cabinet en rez-de-chaussée, accessible PMR",
  },
  ru: {
    roomTitle: "Зал обследования",
    entryTitle: "Вход в кабинет",
    accessTitle: "Доступ",
    metro: "Метро",
    bus: "Автобус",
    pmr: "Доступность",
    metroStation: "Passy",
    metroTime: "450 м",
    metro9Station: "La Muette",
    metro9Time: "500 м",
    busStop: "остановка Jean Bologne",
    busTime: "50 м",
    bus52Stop: "остановка La Muette-Boulainvilliers",
    bus52Time: "450 м",
    parking: "Парковка",
    parkingName: "19 rue de Passy",
    parkingTime: "250 м",
    parking2Name: "Indigo Passy, 80 rue de Passy",
    parking2Time: "500 м",
    parking2Note: "24ч/24ч",
    velib: "Vélib'",
    velibStation: "Passy - Place du Costa Rica",
    velibTime: "300 м",
    onSiteTitle: "На месте",
    onSiteInterphone: "Домофон « Ekaterina Volova »",
    onSiteDirections: "Налево после входной двери, вторая дверь после холла.",
    pmrValue: "Кабинет на первом этаже, доступен для МГН",
  },
  en: {
    roomTitle: "Assessment room",
    entryTitle: "Entrance",
    accessTitle: "Access",
    metro: "Metro",
    bus: "Bus",
    pmr: "Accessibility",
    metroStation: "Passy",
    metroTime: "450 m",
    metro9Station: "La Muette",
    metro9Time: "500 m",
    busStop: "Jean Bologne stop",
    busTime: "50 m",
    bus52Stop: "La Muette-Boulainvilliers stop",
    bus52Time: "450 m",
    parking: "Parking",
    parkingName: "19 rue de Passy",
    parkingTime: "250 m",
    parking2Name: "Indigo Passy, 80 rue de Passy",
    parking2Time: "500 m",
    parking2Note: "24/7",
    velib: "Vélib'",
    velibStation: "Passy - Place du Costa Rica",
    velibTime: "300 m",
    onSiteTitle: "On site",
    onSiteInterphone: "Intercom 'Ekaterina Volova'",
    onSiteDirections: "Turn left after the entrance door, second door past the hall.",
    pmrValue: "Ground-floor practice, wheelchair accessible",
  },
};

const cab = cabinetLabels[lang] ?? cabinetLabels.fr;

const contactHref = getLocalizedPath("/contact", lang);
const aboutHref = getLocalizedPath("/a-propos", lang);
---

{/* ─────────── HERO ─────────── */}
<header class="bg-[var(--color-paper-warm)] border-b border-[var(--color-rule-soft)] relative" style="min-height: calc(100vh - 4.5rem);">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 relative z-10 flex items-center" style="min-height: calc(100vh - 4.5rem);">
    <div class="w-full grid gap-10 md:gap-16 md:grid-cols-[minmax(0,1fr)_20rem] lg:grid-cols-[minmax(0,1fr)_24rem] items-center py-20 sm:py-28">

      {/* Texte */}
      <div>
        <p class="font-serif small-caps text-[0.9375rem] sm:text-[1.0625rem] tracking-[0.12em] text-[var(--color-accent-deep)]">
          {t("home.lede")}
        </p>

        <h1
          class="mt-4 sm:mt-5 font-serif text-[var(--color-ink)] leading-[0.95] tracking-[-0.02em]"
          style="font-size: clamp(3rem, 7vw + 1rem, 6.5rem); font-weight: 300;"
        >
          {t("home.h1")}
        </h1>

        {/* Photo mobile */}
        <div class="mt-8 md:hidden flex justify-center">
          <div class="w-40 aspect-[3/4] relative bg-[var(--color-paper-deep)] p-[8px]">
            <div class="absolute inset-[4px] border border-[var(--color-ink)]/10 pointer-events-none"></div>
            <div class="relative h-full w-full overflow-hidden">
              <Image
                src={portraitEkaterina}
                alt="Ekaterina Volova, psychologue specialisee en neuropsychologie"
                widths={[200, 400]}
                sizes="10rem"
                format="webp"
                quality={88}
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <p class="mt-6 sm:mt-8 font-sans text-[0.75rem] sm:text-[0.8125rem] uppercase tracking-[0.25em] text-[var(--color-ink-muted)]">
          Paris XVI<sup class="text-[0.5rem]">e</sup>
          <span class="mx-3">&bull;</span>
          Sur rendez-vous
        </p>

        <p class="mt-8 font-serif text-[var(--color-ink-soft)] leading-[1.8] max-w-[36rem]"
           style="font-size: clamp(0.9375rem, 0.3vw + 0.85rem, 1.0625rem);">
          {t("site.description")}
        </p>

        <div class="mt-6 font-sans text-[0.6875rem] uppercase tracking-[0.22em] text-[var(--color-ink-faint)]">
          Français
          <span class="mx-2">&bull;</span>
          Русский
          <span class="mx-2">&bull;</span>
          English
        </div>

        <a
          href={contactHref}
          class="mt-10 sm:mt-12 inline-block font-sans text-[0.8125rem] sm:text-[0.875rem] font-semibold uppercase tracking-[0.14em] sm:tracking-[0.18em] no-underline px-8 sm:px-14 py-4 sm:py-5 bg-[#3A5A72] text-white hover:bg-[#2E4A62] transition-all duration-300 text-center"
        >
          {t("cta.book")}
        </a>
      </div>

      {/* Photo desktop */}
      <div class="hidden md:block">
        <div class="aspect-[3/4] w-full relative bg-[var(--color-paper-deep)] p-[12px]">
          <div class="absolute inset-[6px] border border-[var(--color-ink)]/10 pointer-events-none"></div>
          <div class="relative h-full w-full overflow-hidden">
            <Image
              src={portraitEkaterina}
              alt="Ekaterina Volova, psychologue specialisee en neuropsychologie"
              widths={[400, 600, 900]}
              sizes="24rem"
              format="webp"
              quality={88}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>

    </div>
  </div>
</header>

{/* ─────────── 01 — Neuropsychologie ─────────── */}
<section id="neuropsychologie" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          01
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("about.section1_title").replace(/\s*\?$/, "")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <h2 class="font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("about.section1_title")}
        </h2>
        <p
          class="mt-6 font-sans text-[var(--color-ink-soft)] leading-[1.75] text-justify"
          lang={lang}
        >
          {t("about.section1_p1")}
        </p>

        <h2 class="mt-16 font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("about.section2_title")}
        </h2>
        <p
          class="mt-6 font-sans text-[var(--color-ink-soft)] leading-[1.75] text-justify"
          lang={lang}
        >
          {t("about.section2_p1")}
        </p>

        <div class="mt-12">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-6">
            {t("about.section2_steps_intro").replace(/\s*:$/, "")}
          </p>
          <ol class="border-y border-[var(--color-rule)] divide-y divide-[var(--color-rule)]">
            {[
              { title: t("about.section2_step1_title"), desc: t("about.section2_step1_desc") },
              { title: t("about.section2_step2_title"), desc: t("about.section2_step2_desc") },
              { title: t("about.section2_step3_title"), desc: t("about.section2_step3_desc") },
            ].map((step, idx) => (
              <li class="py-6 grid grid-cols-[3rem_minmax(0,1fr)] gap-6 items-baseline">
                <span class="font-serif italic text-[var(--color-ink-faint)] text-2xl tabular-nums">
                  {String(idx + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="font-serif text-[1.125rem] text-[var(--color-ink)] tracking-[-0.01em]" set:html={step.title} />
                  <p class="mt-2 font-sans text-[var(--color-ink-soft)] leading-relaxed">
                    {step.desc}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 02 — Pour qui ─────────── */}
<section id="who" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          02
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("home.who.title")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <h2 class="font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("home.who.title")}
        </h2>
        <p
          class="mt-6 font-sans text-[var(--color-ink-soft)] leading-[1.75] text-justify"
          lang={lang}
        >
          {t("home.who.intro")}
        </p>

        <div class="mt-12">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-6">
            {t("home.who.indications_title")}
          </p>
          <ul class="border-y border-[var(--color-rule)] divide-y divide-[var(--color-rule)]">
            {t("home.who.indications").split(". ").filter(Boolean).map((indication) => (
              <li class="py-4 font-sans text-[var(--color-ink-soft)] leading-relaxed">
                {indication.replace(/\.$/, "")}
              </li>
            ))}
          </ul>
        </div>

        {t("home.who.note") && (
          <p class="mt-10 font-serif italic text-[var(--color-ink-muted)] text-[0.9375rem] leading-relaxed border-l-2 border-[var(--color-rule)] pl-5 text-justify">
            {t("home.who.note")}
          </p>
        )}
      </div>
    </div>
  </div>
</section>

{/* ─────────── 03 — Prestations ─────────── */}
<section id="services" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          03
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("home.services.title")}
        </p>
      </aside>

      <div>
        <ul class="divide-y divide-[var(--color-rule)] border-y border-[var(--color-rule)]">
          {services.map((s, idx) => (
            <li class="py-8 sm:py-10 grid gap-x-10 gap-y-3 sm:grid-cols-[3rem_minmax(0,1fr)_auto] items-baseline">
              <span class="font-serif italic text-[var(--color-ink-faint)] text-2xl tabular-nums">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="font-serif text-[var(--color-ink)] text-[1.375rem] tracking-[-0.012em]">
                  {s.title}
                </h3>
                <p class="mt-3 font-sans text-[var(--color-ink-soft)] leading-relaxed max-w-[36rem] text-justify">
                  {s.desc}
                </p>
                {s.note && (
                  <p class="mt-3 font-serif italic text-sm text-[var(--color-ink-muted)]">
                    {s.note}
                  </p>
                )}
              </div>
              <span class="font-sans text-sm tabular-nums text-[var(--color-accent-deep)] sm:text-right whitespace-nowrap">
                {s.price}
              </span>
            </li>
          ))}
        </ul>

        <div class="mt-14">
          <a
            href={getLocalizedPath("/prestations", lang)}
            class="group inline-flex items-baseline gap-3 font-serif italic text-xl sm:text-2xl text-[var(--color-accent-deep)] no-underline border-b border-[var(--color-accent-deep)]/40 pb-1.5 hover:border-[var(--color-accent-deep)] transition-colors"
          >
            <span>{t("home.services.cta")}</span>
            <span class="font-sans not-italic text-lg transition-transform group-hover:translate-x-1">&#8594;</span>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

{/* ─────────── 04 — Remédiation cognitive ─────────── */}
<section id="remediation" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          04
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          Remédiation
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <h2 class="font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("home.remediation.title")}
        </h2>
        <p
          class="mt-6 font-sans text-[var(--color-ink-soft)] leading-[1.75] text-justify"
          lang={lang}
        >
          {t("home.remediation.desc")}
        </p>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 05 — Langues ─────────── */}
<section id="languages" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          05
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("home.languages.title")}
        </p>
      </aside>

      <dl class="max-w-[42rem] space-y-8">
        <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-x-8 gap-y-2 items-baseline border-b border-[var(--color-rule-soft)] pb-6">
          <dt class="font-serif italic text-2xl text-[var(--color-ink)]" lang="fr">Français</dt>
          <dd class="font-sans text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("home.languages.fr").replace(/^Français — /, "").replace(/^Français - /, "")}
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-x-8 gap-y-2 items-baseline border-b border-[var(--color-rule-soft)] pb-6">
          <dt class="font-serif italic text-2xl text-[var(--color-ink)]" lang="ru">Русский</dt>
          <dd class="font-sans text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("home.languages.ru").replace(/^Русский — /, "").replace(/^Русский - /, "")}
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-x-8 gap-y-2 items-baseline">
          <dt class="font-serif italic text-2xl text-[var(--color-ink)]" lang="en">English</dt>
          <dd class="font-sans text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("home.languages.en").replace(/^English — /, "").replace(/^English - /, "")}
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>

{/* ─────────── 06 — Cabinet ─────────── */}
<section id="cabinet" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          06
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("footer.cabinet_label")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        {/* Adresse */}
        <address class="not-italic font-serif text-[1.5rem] sm:text-[1.75rem] leading-[1.4] text-[var(--color-ink)] tracking-[-0.012em]">
          14 rue Nicolo<br />
          75116 Paris
        </address>
        <p class="mt-4 font-serif italic text-[var(--color-ink-muted)]">
          {t("footer.opening_note")}
        </p>

        {/* Horaires */}
        <div class="mt-6">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
            {t("cabinet.hours_label")}
          </p>
          <p class="mt-2 font-serif text-lg text-[var(--color-ink-soft)]">
            {t("cabinet.hours")}
          </p>
        </div>

        {/* Contact */}
        <div class="mt-6">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
            {t("cabinet.contact_label")}
          </p>
          <div class="mt-2 font-serif text-lg text-[var(--color-ink-soft)] space-y-1">
            <p>
              <a href="tel:+33666074254" class="no-underline text-[var(--color-ink)] hover:text-[var(--color-accent-deep)] transition-colors">
                06 66 07 42 54
              </a>
            </p>
            <p>
              <a href="mailto:volova.neuropsy@gmail.com" class="no-underline text-[var(--color-ink)] hover:text-[var(--color-accent-deep)] transition-colors">
                volova.neuropsy@gmail.com
              </a>
            </p>
          </div>
        </div>

        {/* Doctolib */}
        <div class="mt-6">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
            Doctolib
          </p>
          <p class="mt-2 font-serif text-lg text-[var(--color-ink-muted)] italic">
            {lang === "ru" ? "Скоро" : lang === "en" ? "Coming soon" : "Bientot disponible"}
          </p>
        </div>

        {/* Remboursement */}
        <div class="mt-6">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
            {t("cabinet.reimbursement_label")}
          </p>
          <p class="mt-2 font-serif text-[var(--color-ink-soft)] leading-relaxed text-justify">
            {t("cabinet.reimbursement")}
          </p>
        </div>

        {/* Carte Leaflet + OpenStreetMap */}
        <div class="mt-14 relative aspect-[16/9] sm:aspect-[2/1] border border-[var(--color-rule)] bg-[var(--color-paper-deep)]">
          <div id="cabinet-map" class="absolute inset-0 w-full h-full z-0"></div>
        </div>

        {/* Acces -- pastilles RATP officielles + texte serif lisible */}
        <div class="mt-14 pt-10 border-t border-[var(--color-rule)]">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-8">
            {cab.accessTitle}
          </p>

          <ul class="space-y-6">

            {/* Accessibilite */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="w-9 h-9 rounded-full bg-[var(--color-accent-deep)] inline-flex items-center justify-center text-white translate-y-[0.15em]"
                    aria-label={cab.pmr}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="10" cy="4" r="1.5" fill="currentColor" stroke="none" />
                  <path d="M10 7 v6 h6" />
                  <circle cx="11" cy="17" r="4" />
                  <path d="M14 13 l3 4" />
                </svg>
              </span>
              <div class="font-serif text-[var(--color-ink)] text-lg leading-snug">
                <span class="italic text-[var(--color-ink-muted)]">{cab.pmr}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-soft)]">{cab.pmrValue}</span>
              </div>
            </li>

            {/* Metro ligne 6 */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="font-sans font-semibold text-white text-[0.9375rem] tabular-nums w-9 h-9 rounded-full bg-[#79BB92] inline-flex items-center justify-center leading-none translate-y-[0.15em]"
                    aria-label={`${cab.metro} 6`}>
                6
              </span>
              <div class="font-serif text-[var(--color-ink)] text-lg leading-snug">
                <span class="italic text-[var(--color-ink-muted)]">{cab.metro}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span>{cab.metroStation}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-soft)]">{cab.metroTime}</span>
              </div>
            </li>

            {/* Metro ligne 9 */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="font-sans font-semibold text-white text-[0.9375rem] tabular-nums w-9 h-9 rounded-full bg-[#CDC932] inline-flex items-center justify-center leading-none translate-y-[0.15em]"
                    aria-label={`${cab.metro} 9`}>
                9
              </span>
              <div class="font-serif text-[var(--color-ink)] text-lg leading-snug">
                <span class="italic text-[var(--color-ink-muted)]">{cab.metro}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span>{cab.metro9Station}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-soft)]">{cab.metro9Time}</span>
              </div>
            </li>

            {/* Bus 32 */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="font-sans font-semibold text-white text-[0.9375rem] tabular-nums w-9 h-9 rounded-[2px] bg-[#E1A700] inline-flex items-center justify-center leading-none translate-y-[0.15em]"
                    aria-label={`${cab.bus} 32`}>
                32
              </span>
              <div class="font-serif text-[var(--color-ink)] text-lg leading-snug">
                <span class="italic text-[var(--color-ink-muted)]">{cab.bus}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span>{cab.busStop}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-soft)]">{cab.busTime}</span>
              </div>
            </li>

            {/* Bus 52 */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="font-sans font-semibold text-white text-[0.9375rem] tabular-nums w-9 h-9 rounded-[2px] bg-[#E1A700] inline-flex items-center justify-center leading-none translate-y-[0.15em]"
                    aria-label={`${cab.bus} 52`}>
                52
              </span>
              <div class="font-serif text-[var(--color-ink)] text-lg leading-snug">
                <span class="italic text-[var(--color-ink-muted)]">{cab.bus}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span>{cab.bus52Stop}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-soft)]">{cab.bus52Time}</span>
              </div>
            </li>

            {/* Parking */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="font-sans font-bold text-[var(--color-accent-deep)] text-[0.9375rem] w-9 h-9 rounded-[2px] border-2 border-[var(--color-accent-deep)] inline-flex items-center justify-center leading-none translate-y-[0.15em]"
                    aria-label={cab.parking}>
                P
              </span>
              <div class="font-serif text-[var(--color-ink)] text-lg leading-snug">
                <span class="italic text-[var(--color-ink-muted)]">{cab.parking}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span>{cab.parkingName}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-soft)]">{cab.parkingTime}</span>
              </div>
            </li>

            {/* Parking Indigo */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="font-sans font-bold text-[var(--color-accent-deep)] text-[0.9375rem] w-9 h-9 rounded-[2px] border-2 border-[var(--color-accent-deep)] inline-flex items-center justify-center leading-none translate-y-[0.15em]"
                    aria-label={cab.parking}>
                P
              </span>
              <div class="font-serif text-[var(--color-ink)] text-lg leading-snug">
                <span class="italic text-[var(--color-ink-muted)]">{cab.parking}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span>{cab.parking2Name}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-soft)]">{cab.parking2Time}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-muted)] italic">{cab.parking2Note}</span>
              </div>
            </li>

            {/* Velib' */}
            <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-5 items-baseline">
              <span class="w-9 h-9 rounded-full bg-[#7fba4c] inline-flex items-center justify-center text-white translate-y-[0.15em]"
                    aria-label={cab.velib}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="5.5" cy="17.5" r="3.5" />
                  <circle cx="18.5" cy="17.5" r="3.5" />
                  <path d="M12 2 l-3 15.5" />
                  <path d="M9 17.5 L15 7 h3" />
                  <path d="M5.5 17.5 L12 2" />
                </svg>
              </span>
              <div class="font-serif text-[var(--color-ink)] text-lg leading-snug">
                <span class="italic text-[var(--color-ink-muted)]">{cab.velib}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span>{cab.velibStation}</span>
                <span class="mx-2 text-[var(--color-rule)]">·</span>
                <span class="text-[var(--color-ink-soft)]">{cab.velibTime}</span>
              </div>
            </li>

          </ul>

          {/* Sur place */}
          <div class="mt-10 pt-8 border-t border-[var(--color-rule-soft)]">
            <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-5">
              {cab.onSiteTitle}
            </p>
            <div class="font-serif text-[var(--color-ink)] text-lg leading-relaxed space-y-2">
              <p>{cab.onSiteInterphone}</p>
              <p class="text-[var(--color-ink-soft)]">{cab.onSiteDirections}</p>
            </div>
          </div>

          <script is:inline>
          (function() {
            var mapEl = document.getElementById('cabinet-map');
            if (!mapEl) return;

            var loaded = false;
            var observer = new IntersectionObserver(function(entries) {
              if (entries[0].isIntersecting && !loaded) {
                loaded = true;
                observer.disconnect();
                initMap();
              }
            }, { rootMargin: '200px' });
            observer.observe(mapEl);

            function initMap() {
              var link = document.createElement('link');
              link.rel = 'stylesheet';
              link.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
              document.head.appendChild(link);

              var script = document.createElement('script');
              script.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
              script.onload = function() { buildMap(); };
              document.head.appendChild(script);
            }

            function buildMap() {
              var L = window.L;
              var map = L.map('cabinet-map', {
                scrollWheelZoom: false,
                attributionControl: false
              }).setView([48.85824, 2.27980], 16);

              L.control.attribution({
                prefix: '<a href="https://leafletjs.com" target="_blank">Leaflet</a>'
              }).addTo(map);

              L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                maxZoom: 19
              }).addTo(map);

              function badge(color, label, shape, textColor) {
                var radius = shape === 'square' ? '3px' : '50%';
                var tc = textColor || '#2c2c2c';
                return L.divIcon({
                  className: '',
                  html: '<div style="' +
                    'width:30px;height:30px;border-radius:' + radius + ';' +
                    'background:' + color + ';color:' + tc + ';' +
                    'display:flex;align-items:center;justify-content:center;' +
                    'font-family:Inter,sans-serif;font-weight:700;font-size:12px;' +
                    'box-shadow:0 2px 6px rgba(0,0,0,.35);border:2.5px solid #2c2c2c;' +
                    '">' + label + '</div>',
                  iconSize: [30, 30],
                  iconAnchor: [15, 15]
                });
              }

              var cabinetIcon = L.divIcon({
                className: '',
                html: '<div style="position:relative;width:44px;height:58px;">' +
                  '<svg width="44" height="58" viewBox="0 0 44 58" fill="none" xmlns="http://www.w3.org/2000/svg">' +
                    '<filter id="pin-shadow"><feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity="0.35"/></filter>' +
                    '<path d="M22 56 C22 56 42 34 42 20 A20 20 0 0 0 2 20 C2 34 22 56 22 56Z" fill="#C0392B" stroke="#fff" stroke-width="2.5" filter="url(#pin-shadow)"/>' +
                    '<text x="22" y="27" text-anchor="middle" fill="#fff" font-family="serif" font-size="22" font-weight="400">&Psi;</text>' +
                  '</svg>' +
                '</div>',
                iconSize: [44, 58],
                iconAnchor: [22, 56]
              });
              L.marker([48.85874, 2.28036], { icon: cabinetIcon })
                .addTo(map)
                .bindPopup('<b>Cabinet</b><br>14 rue Nicolo');

              L.marker([48.85752, 2.28583], { icon: badge('#79BB92', '6', 'circle') })
                .addTo(map)
                .bindPopup('<b>Métro 6</b><br>Passy');

              L.marker([48.85809, 2.27412], { icon: badge('#CDC932', '9', 'circle') })
                .addTo(map)
                .bindPopup('<b>Métro 9</b><br>La Muette');

              L.marker([48.85773, 2.28024], { icon: badge('#E1A700', '32', 'square') })
                .addTo(map)
                .bindPopup('<b>Bus 32</b><br>Jean Bologne');

              L.marker([48.85857, 2.27490], { icon: badge('#E1A700', '52', 'square') })
                .addTo(map)
                .bindPopup('<b>Bus 52</b><br>La Muette-Boulainvilliers');

              var parkingIcon = L.divIcon({
                className: '',
                html: '<div style="' +
                  'width:30px;height:30px;border-radius:3px;' +
                  'background:#3b82f6;color:#fff;' +
                  'display:flex;align-items:center;justify-content:center;' +
                  'font-family:Inter,sans-serif;font-weight:700;font-size:14px;' +
                  'box-shadow:0 2px 6px rgba(0,0,0,.35);border:2.5px solid #2c2c2c;' +
                  '">P</div>',
                iconSize: [30, 30],
                iconAnchor: [15, 15]
              });
              L.marker([48.8581, 2.2828], { icon: parkingIcon })
                .addTo(map)
                .bindPopup('<b>Parking</b><br>19 rue de Passy');

              L.marker([48.8582, 2.2752], { icon: parkingIcon })
                .addTo(map)
                .bindPopup('<b>Indigo Passy</b><br>80 rue de Passy<br>24h/24');
            }
          })();
          </script>
        </div>
      </div>
    </div>
  </div>
</section>

