---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";
import Container from "./Container.astro";
import Section from "./Section.astro";
import Ornament from "./Ornament.astro";
import Button from "./Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const specialties = Array.from({ length: 11 }, (_, i) => t(`home.intro.spec_${i + 1}` as any));

const contactHref = getLocalizedPath("/contact", lang);
const mapUrl = "https://www.openstreetmap.org/search?query=" + encodeURIComponent("14 rue Nicolo, 75116 Paris");

// Transports proches du cabinet. Couleurs officielles des lignes RATP.
const metroStations = [
  { badge: "9", name: "La Muette", bg: "#B6BD00", fg: "#1b1b1b" },
  { badge: "6", name: "Passy", bg: "#6ECA97", fg: "#1b1b1b" },
];
const rerStations = [
  { badge: "C", name: "Boulainvilliers", bg: "#FCD946", fg: "#1b1b1b" },
];
const busLines = "22, 32, 63, 72";

// Lignes du tableau des tarifs (libellé + prix, depuis i18n).
const priceItems = [
  { label: "prestations.entretien_title", price: "prestations.entretien_price" },
  { label: "prestations.bilan_1", price: "prestations.bilan_1_price" },
  { label: "prestations.bilan_2", price: "prestations.bilan_2_price" },
  { label: "prestations.bilan_3", price: "prestations.bilan_3_price" },
  { label: "prestations.bilan_4", price: "prestations.bilan_4_price" },
  { label: "prestations.remediation_title", price: "prestations.remediation_price" },
];
---

{/* Hero */}
<section class="bg-[var(--color-paper)] pt-8 pb-0">
  <Container width="wide">
    <div class="flex flex-col items-center md:flex-row md:justify-center md:items-center gap-10 md:gap-14">
      <img
        src="/images/portrait-ekaterina.jpg"
        alt="Ekaterina Volova"
        class="aspect-square w-full max-w-[15rem] shrink-0 object-cover object-[center_25%] rounded-full border border-[var(--color-rule-soft)]"
      />

      <div class="text-center">
        <h1 id="hero-name" class="font-serif italic text-[var(--color-accent-deep)]">{t("home.h1")}</h1>
        <p class="mt-2 font-serif text-sm uppercase tracking-[0.15em] text-[var(--color-ink-muted)]">{t("home.lede")}</p>
        <p class="mt-4 font-serif italic text-base text-[var(--color-ink)]">
          {t("home.hero.line1_pre")}<span class="underline decoration-1 underline-offset-4">{t("home.hero.line1_em")}</span>
        </p>
        <p class="mt-1 font-serif italic text-base text-[var(--color-ink)]">{t("home.hero.line2")}</p>

        <div id="hero-cta" class="mt-6">
          <Button href={contactHref} variant="secondary" size="md">{t("cta.book")}</Button>
        </div>
      </div>
    </div>
  </Container>
</section>

{/* À propos - présentation courte */}
<Section tone="paper" spacing="normal" as="section" id="presentation" class="!py-0">
  <Container width="content">
    <Ornament tone="accent" spacing="sm" class="!my-12" />
    <h2 class="font-serif italic text-center">{t("home.intro.title")}</h2>

    <div class="mt-8 max-w-[44rem] mx-auto text-[var(--color-ink-soft)] leading-relaxed text-justify">
      <p>{t("home.intro.text")}</p>
    </div>

    <ul class="mt-6 flex flex-wrap justify-center gap-2.5 max-w-[40rem] mx-auto list-none p-0">
      {specialties.map((s) => (
        <li class="inline-flex items-center rounded-full border border-[var(--color-rule-soft)] bg-[var(--color-accent-soft)] px-4 py-1.5 text-sm text-[var(--color-ink-soft)]">
          {s}
        </li>
      ))}
    </ul>

    <p class="mt-6 text-center">
      <a href={getLocalizedPath("/a-propos", lang)} class="font-serif italic text-base sm:text-lg text-[var(--color-ink-muted)]! hover:text-[var(--color-ink)]! no-underline transition-colors">
        {t("home.intro.cta")}
      </a>
    </p>
  </Container>
</Section>

{/* Tarifs */}
<Section tone="paper" spacing="normal" as="section" id="tarifs" class="!py-0">
  <Container width="content">
    <Ornament tone="accent" spacing="sm" class="!my-12" />
    <h2 class="font-serif italic text-center">{t("home.tarifs.title")}</h2>

    <div class="mt-10 max-w-[32rem] mx-auto space-y-4">
      {priceItems.map((item) => (
        <div class="flex items-baseline gap-3">
          <span class="text-[var(--color-ink-soft)]">{t(item.label as any)}</span>
          <span class="flex-1 translate-y-[-0.25em] border-b border-dotted border-[var(--color-rule)]" aria-hidden="true"></span>
          <span class="whitespace-nowrap font-medium tabular-nums text-[var(--color-accent-deep)]">{t(item.price as any)}</span>
        </div>
      ))}
    </div>

    <p class="mt-6 text-center">
      <a href={getLocalizedPath("/prestations", lang)} class="font-serif italic text-base sm:text-lg text-[var(--color-ink-muted)]! hover:text-[var(--color-ink)]! no-underline transition-colors">
        {t("home.tarifs.cta")}
      </a>
    </p>
  </Container>
</Section>

{/* Cabinet */}
<Section tone="paper" spacing="normal" as="section" id="cabinet" class="!pt-0 !pb-8">
  <Container width="content">
    <Ornament tone="accent" spacing="sm" class="!my-12" />
    <h2 class="font-serif italic text-center">{t("home.cabinet.title")}</h2>

    {/* Emplacement photo - à remplacer la semaine prochaine */}
    <div class="mt-10 max-w-[36rem] mx-auto aspect-[3/2] rounded-[var(--radius-md)] border border-dashed border-[var(--color-rule-soft)] bg-[var(--color-paper-warm)] flex items-center justify-center">
      <span class="font-serif italic text-sm text-[var(--color-ink-muted)]">{t("home.cabinet.photo_placeholder")}</span>
    </div>

    <p class="mt-8 text-center text-[var(--color-ink-soft)]">{t("footer.office_address")}</p>

    <div class="mt-6 flex justify-center gap-10 sm:gap-16 text-left">
      {/* Colonne 1 : métro */}
      <ul class="flex flex-col gap-2.5 list-none p-0 m-0">
        {metroStations.map((s) => (
          <li class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-[0.8125rem] font-bold leading-none shrink-0" style={`background:${s.bg};color:${s.fg}`} aria-hidden="true">{s.badge}</span>
            <span class="text-[var(--color-ink-soft)]">{s.name}</span>
          </li>
        ))}
      </ul>

      {/* Colonne 2 : RER + bus */}
      <ul class="flex flex-col gap-2.5 list-none p-0 m-0">
        {rerStations.map((s) => (
          <li class="flex items-center gap-2.5">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-[var(--radius-sm)] text-[0.8125rem] font-bold leading-none shrink-0" style={`background:${s.bg};color:${s.fg}`} aria-hidden="true">{s.badge}</span>
            <span class="text-[var(--color-ink-soft)]">{s.name}</span>
          </li>
        ))}
        <li class="flex items-center gap-2.5">
          <span class="inline-flex items-center justify-center h-6 px-2 rounded-[var(--radius-sm)] text-[0.6875rem] font-bold uppercase tracking-wide leading-none bg-[var(--color-ink)] text-[var(--color-paper)] shrink-0" aria-hidden="true">Bus</span>
          <span class="text-[var(--color-ink-soft)]">{busLines}</span>
        </li>
      </ul>
    </div>

    <p class="mt-6 text-center">
      <a href={mapUrl} target="_blank" rel="noopener noreferrer" class="font-serif italic text-base sm:text-lg text-[var(--color-ink-muted)]! hover:text-[var(--color-ink)]! no-underline transition-colors">
        {t("home.cabinet.map_link")}
      </a>
    </p>
  </Container>
</Section>
