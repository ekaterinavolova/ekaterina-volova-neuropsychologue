---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Unité de distance (cyrillique en russe).
const m = lang === "ru" ? "м" : "m";

// Transports proches du cabinet. Couleurs officielles des lignes RATP.
// Distances à pied depuis le 14 rue Nicolo, vérifiées par routage OSM (juin 2026).
const railLines = [
  { badge: "9", name: "La Muette", dist: `600 ${m}`, bg: "#B6BD00", fg: "#1b1b1b", shape: "circle" },
  { badge: "6", name: "Passy", dist: `550 ${m}`, bg: "#6ECA97", fg: "#1b1b1b", shape: "circle" },
  { badge: "C", name: "Boulainvilliers", dist: `650 ${m}`, bg: "#FCD946", fg: "#1b1b1b", shape: "square" },
];
const busStops = [
  { lines: "32", name: "Jean Bologne", dist: `200 ${m}` },
  { lines: "22, 52", name: "La Muette-Boulainvilliers", dist: `550 ${m}` },
];
---

<div class="flex flex-col items-center md:items-start gap-5">
  <div class="flex flex-col gap-2.5 text-left">
    {/* Colonne 1 : métro + RER */}
    <ul class="flex flex-col gap-2.5 list-none p-0 m-0">
      {railLines.map((s) => (
        <li class="flex items-center gap-2.5">
          <span class:list={["inline-flex items-center justify-center w-6 h-6 text-[0.8125rem] font-bold leading-none shrink-0", s.shape === "circle" ? "rounded-full" : "rounded-[var(--radius-sm)]"]} style={`background:${s.bg};color:${s.fg}`} aria-hidden="true">{s.badge}</span>
          <span class="text-[var(--color-ink-soft)]">{s.name}</span>
          <span class="text-sm text-[var(--color-ink-muted)] whitespace-nowrap">· {s.dist}</span>
        </li>
      ))}
    </ul>

    {/* Colonne 2 : bus */}
    <ul class="flex flex-col gap-2.5 list-none p-0 m-0">
      {busStops.map((s) => (
        <li class="flex items-center gap-2.5">
          <span class="inline-flex items-center justify-center h-6 px-2 rounded-[var(--radius-sm)] text-[0.6875rem] font-bold uppercase tracking-wide leading-none bg-[var(--color-ink)] text-[var(--color-paper)] shrink-0" aria-hidden="true">Bus</span>
          <span class="text-[var(--color-ink-soft)]">{s.lines} · {s.name} <span class="text-sm text-[var(--color-ink-muted)] whitespace-nowrap">· {s.dist}</span></span>
        </li>
      ))}
    </ul>
  </div>

  {/* Horaires + accessibilité PMR */}
  <div class="flex flex-col items-center md:items-start gap-2.5">
    <p class="flex items-start justify-start gap-2.5 text-[var(--color-ink-soft)] m-0">
      <svg class="w-4 h-4 mt-1 shrink-0 text-[var(--color-accent-deep)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <polyline points="12 6 12 12 16 14" />
      </svg>
      {t("cabinet.hours")}
    </p>
    <p class="flex items-start justify-start gap-2.5 text-[var(--color-ink-soft)] m-0">
      <svg class="w-4 h-4 mt-1 shrink-0 text-[var(--color-accent-deep)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="16" cy="4" r="1" />
        <path d="m18 19 1-7-6 1" />
        <path d="m5 8 3-3 5.5 3-2.36 3.5" />
        <path d="M4.24 14.5a5 5 0 0 0 6.88 6" />
        <path d="M13.76 17.5a5 5 0 0 0-6.88-6" />
      </svg>
      {t("cabinet.pmr")}
    </p>
  </div>
</div>
