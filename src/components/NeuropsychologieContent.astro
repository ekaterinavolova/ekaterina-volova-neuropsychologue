---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";
import Container from "./Container.astro";
import Section from "./Section.astro";
import Ornament from "./Ornament.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const bilanSteps = [
  {
    title: t("about.section2_step1_title"),
    desc: t("about.section2_step1_desc"),
  },
  {
    title: t("about.section2_step2_title"),
    desc: t("about.section2_step2_desc"),
  },
  {
    title: t("about.section2_step3_title"),
    desc: t("about.section2_step3_desc"),
  },
];
---

<Section tone="paper" spacing="normal" as="header" class="!pt-6 !pb-0">
  <Container width="content">
    <h1 class="sr-only">{t("nav.neuropsychologie")}</h1>
    <div class="flex justify-center">
      <img src="/images/cerveau-aquarelle.png" alt="" aria-hidden="true" width="640" height="640" decoding="async" class="w-44 sm:w-52 h-auto" />
    </div>
  </Container>
</Section>

{/* Qu'est-ce que la neuropsychologie ? */}
<Section tone="paper" spacing="normal" as="section" id="discipline" class="!pt-6 !pb-0">
  <Container width="content">
    <h2 class="font-serif italic text-center text-xl sm:text-2xl">
      <span class="text-[var(--color-accent-deep)] mr-3" aria-hidden="true">I.</span>{t("about.section1_title")}
    </h2>

    <div class="mt-8 max-w-[44rem] mx-auto text-[var(--color-ink-soft)] leading-[1.85] text-left sm:text-justify">
      <p>{t("about.section1_p1")}</p>
    </div>
  </Container>
</Section>

{/* Qu'est-ce qu'un bilan neuropsychologique ? */}
<Section tone="paper" spacing="normal" as="section" id="bilan" class="!py-0">
  <Container width="content">
    <Ornament tone="accent" spacing="sm" class="!my-12" />
    <h2 class="font-serif italic text-center text-xl sm:text-2xl">
      <span class="text-[var(--color-accent-deep)] mr-3" aria-hidden="true">II.</span>{t("about.section2_title")}
    </h2>

    <div class="mt-8 max-w-[44rem] mx-auto space-y-6 text-[var(--color-ink-soft)] leading-relaxed text-justify">
      <p>{t("about.section2_p1")}</p>
    </div>

    <div class="mt-10 max-w-[44rem] mx-auto">
      <h3 class="font-serif italic text-base sm:text-lg tracking-tight text-[var(--color-ink)] mb-3">
        {t("about.section2_steps_intro")}
      </h3>
      <ol class="space-y-4">
        {bilanSteps.map((step, idx) => (
          <li class="grid grid-cols-[3rem_1fr] gap-6 items-baseline">
            <span class="font-serif italic text-3xl text-[var(--color-accent-deep)] tabular-nums">
              {idx + 1}
            </span>
            <div>
              <h3 class="font-serif text-base font-bold" set:html={step.title} />
              <p class="mt-2 text-[var(--color-ink-soft)] leading-relaxed text-justify">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Container>
</Section>

{/* Qu'est-ce qu'une remédiation et stimulation cognitive ? */}
<Section tone="paper" spacing="normal" as="section" id="remediation" class="!pt-0 !pb-8">
  <Container width="content">
    <Ornament tone="accent" spacing="sm" class="!my-12" />
    <h2 class="font-serif italic text-center text-xl sm:text-2xl">
      <span class="text-[var(--color-accent-deep)] mr-3" aria-hidden="true">III.</span>{t("home.remediation.title")}
    </h2>
    <div class="mt-8 max-w-[44rem] mx-auto text-[var(--color-ink-soft)] leading-relaxed text-justify">
      <p>{t("home.remediation.desc")}</p>
    </div>

    <p class="mt-6 text-center">
      <a href={getLocalizedPath("/prestations", lang)} class="font-serif italic text-base sm:text-lg text-[var(--color-ink-muted)]! hover:text-[var(--color-ink)]! no-underline transition-colors">
        {t("home.tarifs.cta")}
      </a>
    </p>
  </Container>
</Section>
