---
import { languages, type Lang, defaultLang } from "~/i18n/ui";
import { getLangFromUrl } from "~/i18n/utils";

interface Props {
  class?: string;
  tone?: "light" | "dark";
}

const { class: className = "", tone = "dark" } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);

const cleanPath = Astro.url.pathname.replace(/^\/(ru|en)/, "") || "/";

function pathForLang(lang: Lang): string {
  if (lang === defaultLang) {
    return cleanPath;
  }
  return cleanPath === "/" ? `/${lang}/` : `/${lang}${cleanPath}`;
}

const langOrder: Lang[] = ["fr", "ru", "en"];

const styles = {
  dark: {
    sep: "text-white/30",
    active: "text-white font-medium",
    inactive: "text-white/50 hover:text-white",
  },
  light: {
    sep: "text-[var(--color-ink-faint)]",
    active: "text-[var(--color-accent-deep)] font-medium",
    inactive: "text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]",
  },
};

const s = styles[tone];
---

<nav aria-label="Langue / Language / Язык" class={`flex items-center gap-1 text-[0.875rem] ${className}`}>
  {
    langOrder.map((lang, idx) => {
      const isActive = lang === currentLang;
      return (
        <>
          {idx > 0 && <span class={`${s.sep} select-none`} aria-hidden="true">&middot;</span>}
          <a
            href={pathForLang(lang)}
            class:list={[
              "px-2 py-2 no-underline uppercase tracking-wider transition-colors",
              isActive ? s.active : s.inactive,
            ]}
            aria-current={isActive ? "true" : undefined}
            lang={lang}
            hreflang={lang}
          >
            {lang === "fr" ? "FR" : lang === "ru" ? "RU" : "EN"}
          </a>
        </>
      );
    })
  }
</nav>
