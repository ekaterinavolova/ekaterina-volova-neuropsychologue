---
type Variant = "primary" | "secondary" | "ghost";
type Size = "md" | "lg";

interface Props {
  href?: string;
  variant?: Variant;
  size?: Size;
  external?: boolean;
  class?: string;
  type?: "button" | "submit" | "reset";
  ariaLabel?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  external = false,
  class: className = "",
  type = "button",
  ariaLabel,
} = Astro.props;

const baseClass =
  "inline-flex items-center justify-center font-medium tracking-tight " +
  "no-underline transition-all duration-[var(--duration-medium)] ease-[var(--ease-out)] " +
  "focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[var(--color-accent)]";

const sizeClass: Record<Size, string> = {
  md: "px-6 py-3 text-[0.9375rem] rounded-[var(--radius-md)]",
  lg: "px-8 py-4 text-base rounded-[var(--radius-md)]",
};

const variantClass: Record<Variant, string> = {
  primary:
    "bg-[var(--color-ink)] text-[var(--color-paper)] " +
    "hover:bg-[var(--color-accent-deep)] " +
    "active:scale-[0.98]",
  secondary:
    "bg-transparent text-[var(--color-ink)] " +
    "ring-1 ring-[var(--color-ink)] " +
    "hover:bg-[var(--color-accent-deep)] hover:text-[var(--color-paper)] hover:ring-[var(--color-accent-deep)]",
  ghost:
    "bg-transparent text-[var(--color-ink-soft)] " +
    "hover:text-[var(--color-ink)] hover:bg-[var(--color-paper-warm)]",
};

const classes = `${baseClass} ${sizeClass[size]} ${variantClass[variant]} ${className}`;

const externalProps = external
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel} {...externalProps}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}
