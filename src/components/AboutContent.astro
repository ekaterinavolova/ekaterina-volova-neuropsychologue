---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import Container from "./Container.astro";
import Section from "./Section.astro";
import Ornament from "./Ornament.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experience = Array.from({ length: 5 }, (_, i) => ({
  dates: t(`about.exp_${i + 1}_dates` as any),
  title: t(`about.exp_${i + 1}_title` as any),
  desc: t(`about.exp_${i + 1}_desc` as any),
}));

const education = Array.from({ length: 4 }, (_, i) => ({
  dates: t(`about.edu_${i + 1}_dates` as any),
  title: t(`about.edu_${i + 1}_title` as any),
  desc: t(`about.edu_${i + 1}_desc` as any),
}));
---

{/* Hero compact */}
<Section tone="paper" spacing="normal" as="header">
  <Container width="content">
    <div class="flex flex-col sm:flex-row gap-8 sm:gap-12 items-center">
      <div class="text-center sm:text-left">
        <p class="font-serif italic text-[0.8125rem] tracking-[0.08em] text-[var(--color-rose-deep)] mb-2">
          {t("about.eyebrow")}
        </p>
        <h1 class="font-serif italic text-2xl sm:text-3xl text-[var(--color-accent-deep)]">
          {t("home.h1")}
        </h1>
        <p class="mt-3 font-serif italic text-base sm:text-lg text-[var(--color-ink-soft)]">
          {t("home.lede")}
        </p>
      </div>

      {/* Photo */}
      <div
        class="aspect-[3/4] w-full max-w-[14rem] shrink-0 bg-[var(--color-paper-deep)] border border-[var(--color-rule-soft)] rounded-[var(--radius-sm)]"
        aria-hidden="true"
      ></div>
    </div>
  </Container>
</Section>

{/* Expérience professionnelle */}
<Section tone="paper" spacing="normal" as="section" id="experience">
  <Container width="content">
    <Ornament tone="rose" spacing="sm" class="!mt-0 !mb-12" />
    <h2 class="font-serif italic text-center text-lg sm:text-xl text-[var(--color-ink-soft)]">{t("about.experience_title")}</h2>

    <p class="mt-10 max-w-[44rem] mx-auto text-sm text-[var(--color-ink-muted)] italic leading-relaxed text-center">
      {t("about.section3_intro")}
    </p>

    <ol class="mt-14 max-w-[44rem] mx-auto space-y-8">
      {experience.map((entry) => (
        <li>
          <span class="font-serif italic text-[var(--color-accent-deep)] tabular-nums text-[0.9375rem] tracking-tight">
            {entry.dates}
          </span>
          <h3 class="font-serif text-lg mt-1">{entry.title}</h3>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)] leading-relaxed text-justify">{entry.desc}</p>
        </li>
      ))}
    </ol>
  </Container>
</Section>

{/* Formation */}
<Section tone="paper" spacing="normal" as="section" id="formation">
  <Container width="content">
    <Ornament tone="gold" spacing="sm" class="!mt-0 !mb-12" />
    <h2 class="font-serif italic text-center text-lg sm:text-xl text-[var(--color-ink-soft)]">{t("about.education_title")}</h2>

    <ol class="mt-14 max-w-[44rem] mx-auto space-y-8">
      {education.map((entry) => (
        <li>
          <span class="font-serif italic text-[var(--color-accent-deep)] tabular-nums text-[0.9375rem] tracking-tight">
            {entry.dates}
          </span>
          <h3 class="font-serif text-lg mt-1">{entry.title}</h3>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)] leading-relaxed text-justify" set:html={entry.desc} />
        </li>
      ))}
    </ol>

    <p class="mt-14 max-w-[44rem] mx-auto font-serif italic font-bold text-center text-lg sm:text-xl text-[var(--color-accent-deep)]">
      {t("about.languages_note")}
    </p>
  </Container>
</Section>
