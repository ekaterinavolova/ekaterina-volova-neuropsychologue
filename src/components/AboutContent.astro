---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";
import { Image } from "astro:assets";
import portraitAbout from "~/assets/portrait-ekaterina-about.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  {
    title: t("about.section2_step1_title"),
    desc: t("about.section2_step1_desc"),
  },
  {
    title: t("about.section2_step2_title"),
    desc: t("about.section2_step2_desc"),
  },
  {
    title: t("about.section2_step3_title"),
    desc: t("about.section2_step3_desc"),
  },
];

const experience = Array.from({ length: 5 }, (_, i) => ({
  dates: t(`about.exp_${i + 1}_dates` as any),
  title: t(`about.exp_${i + 1}_title` as any),
  desc: t(`about.exp_${i + 1}_desc` as any),
}));

const education = Array.from({ length: 4 }, (_, i) => ({
  dates: t(`about.edu_${i + 1}_dates` as any),
  title: t(`about.edu_${i + 1}_title` as any),
  desc: t(`about.edu_${i + 1}_desc` as any),
}));

const contactHref = getLocalizedPath("/contact", lang);
---

{/* ─────────── HERO ─────────── */}
<header class="bg-[var(--color-paper)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 pt-10 sm:pt-14 pb-20 sm:pb-24">

    <p class="font-sans text-[0.8125rem] sm:text-sm uppercase tracking-[0.14em] text-[var(--color-accent)] mb-12 sm:mb-16">
      {t("about.eyebrow")}
    </p>

    <div class="grid gap-10 md:gap-16 md:grid-cols-[minmax(0,1fr)_18rem] lg:grid-cols-[minmax(0,1fr)_22rem] items-center">
      <div>
        <h1
          class="font-serif italic text-[var(--color-ink)] leading-[0.98] tracking-[-0.025em]"
          style="font-size: clamp(2.75rem, 6vw + 1rem, 5.5rem);"
        >
          {t("home.h1")}
        </h1>

        {/* Photo mobile */}
        <div class="mt-8 md:hidden flex justify-center">
          <div class="w-40 aspect-[3/4] relative bg-[var(--color-paper-deep)] p-[8px]">
            <div class="absolute inset-[4px] border border-[var(--color-ink)]/10 pointer-events-none"></div>
            <div class="relative h-full w-full overflow-hidden">
              <Image
                src={portraitAbout}
                alt="Ekaterina Volova, psychologue specialisee en neuropsychologie"
                widths={[200, 400]}
                sizes="10rem"
                format="webp"
                quality={88}
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <p class="mt-8 sm:mt-10 font-serif italic text-xl sm:text-2xl text-[var(--color-ink-soft)] leading-relaxed max-w-[40rem]">
          {t("home.lede")}
        </p>

        <p class="mt-6 font-serif italic text-[var(--color-ink-muted)] text-lg">
          Français
          <span class="mx-2.5 text-[var(--color-rule)]">·</span>
          Русский
          <span class="mx-2.5 text-[var(--color-rule)]">·</span>
          English
        </p>
      </div>

      {/* Photo desktop */}
      <div class="hidden md:block">
        <div class="aspect-[3/4] w-full relative bg-[var(--color-paper-deep)] p-[12px]">
          <div class="absolute inset-[6px] border border-[var(--color-ink)]/10 pointer-events-none"></div>
          <div class="relative h-full w-full overflow-hidden">
            <Image
              src={portraitAbout}
              alt="Ekaterina Volova, psychologue specialisee en neuropsychologie"
              widths={[400, 600]}
              sizes="22rem"
              format="webp"
              quality={88}
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

{/* ─────────── 01 — Experience professionnelle ─────────── */}
<section id="experience" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent)] text-5xl sm:text-6xl leading-none tracking-tight">
          01
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("about.experience_title")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <p
          class="font-serif italic text-[var(--color-ink-muted)] leading-relaxed text-[0.9375rem] border-l-2 border-[var(--color-rule)] pl-5"
          style="hyphens: auto;"
          lang={lang}
        >
          {t("about.section3_intro")}
        </p>

        <ol class="mt-12 border-y border-[var(--color-rule)] divide-y divide-[var(--color-rule)]">
          {experience.map((entry) => (
            <li class="py-7 grid gap-x-10 gap-y-2 sm:grid-cols-[10rem_minmax(0,1fr)] items-baseline">
              <span class="font-serif italic text-[var(--color-accent)] tabular-nums text-[0.9375rem] tracking-tight">
                {entry.dates}
              </span>
              <div>
                <h3 class="font-serif text-[1.125rem] text-[var(--color-ink)] tracking-[-0.01em]">
                  {entry.title}
                </h3>
                <p class="mt-1 font-sans text-sm text-[var(--color-ink-soft)] leading-relaxed text-justify">
                  {entry.desc}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 02 — Formation ─────────── */}
<section id="formation" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent)] text-5xl sm:text-6xl leading-none tracking-tight">
          02
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("about.education_title")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <ol class="border-y border-[var(--color-rule)] divide-y divide-[var(--color-rule)]">
          {education.map((entry) => (
            <li class="py-7 grid gap-x-10 gap-y-2 sm:grid-cols-[10rem_minmax(0,1fr)] items-baseline">
              <span class="font-serif italic text-[var(--color-accent)] tabular-nums text-[0.9375rem] tracking-tight">
                {entry.dates}
              </span>
              <div>
                <h3 class="font-serif text-[1.125rem] text-[var(--color-ink)] tracking-[-0.01em]">
                  {entry.title}
                </h3>
                {entry.desc && (
                  <div class="mt-1 font-sans text-sm text-[var(--color-ink-soft)] leading-relaxed" set:html={entry.desc} />
                )}
              </div>
            </li>
          ))}
        </ol>

        <p class="mt-10 font-serif italic text-[var(--color-ink-soft)] leading-relaxed">
          {t("about.languages_note")}
        </p>
      </div>
    </div>
  </div>
</section>
