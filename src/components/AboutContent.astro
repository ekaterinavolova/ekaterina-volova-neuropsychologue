---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import Container from "./Container.astro";
import Section from "./Section.astro";
import Ornament from "./Ornament.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const experience = Array.from({ length: 5 }, (_, i) => ({
  dates: t(`about.exp_${i + 1}_dates` as any),
  title: t(`about.exp_${i + 1}_title` as any),
  desc: t(`about.exp_${i + 1}_desc` as any),
}));

const education = Array.from({ length: 4 }, (_, i) => ({
  dates: t(`about.edu_${i + 1}_dates` as any),
  title: t(`about.edu_${i + 1}_title` as any),
  desc: t(`about.edu_${i + 1}_desc` as any),
}));
---

{/* Titre de page, même gabarit que Prestations / Contact */}
<Section tone="paper" spacing="normal" as="header" class="!pt-12 !pb-0">
  <Container width="content">
    <h1 class="font-serif italic text-center text-[clamp(1.75rem,2vw_+_1rem,2.5rem)]">{t("about.eyebrow")}</h1>
  </Container>
</Section>

{/* Expérience professionnelle */}
<Section tone="paper" spacing="normal" as="section" id="experience" class="!pt-8 !pb-0">
  <Container width="content">
    <h2 class="font-serif italic text-center text-xl sm:text-2xl">
      <span class="text-[var(--color-accent-deep)] mr-3" aria-hidden="true">I.</span>{t("about.experience_title")}
    </h2>

    <p class="mt-8 max-w-[44rem] mx-auto text-sm text-[var(--color-ink-muted)] italic leading-relaxed text-center">
      {t("about.section3_intro")}
    </p>

    <ol class="mt-10 max-w-[44rem] mx-auto space-y-8">
      {experience.map((entry) => (
        <li>
          <span class="font-serif italic text-[var(--color-accent-deep)] tabular-nums text-[0.9375rem] tracking-tight">
            {entry.dates}
          </span>
          <h3 class="font-serif text-lg mt-1">{entry.title}</h3>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)] leading-relaxed text-justify">{entry.desc}</p>
        </li>
      ))}
    </ol>
  </Container>
</Section>

{/* Formation */}
<Section tone="paper" spacing="normal" as="section" id="formation" class="!pt-0 !pb-8">
  <Container width="content">
    <Ornament tone="accent" spacing="sm" class="!my-12" />
    <h2 class="font-serif italic text-center text-xl sm:text-2xl">
      <span class="text-[var(--color-accent-deep)] mr-3" aria-hidden="true">II.</span>{t("about.education_title")}
    </h2>

    <ol class="mt-8 max-w-[44rem] mx-auto space-y-8">
      {education.map((entry) => (
        <li>
          <span class="font-serif italic text-[var(--color-accent-deep)] tabular-nums text-[0.9375rem] tracking-tight">
            {entry.dates}
          </span>
          <h3 class="font-serif text-lg mt-1" set:html={entry.title}></h3>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)] leading-relaxed text-justify" set:html={entry.desc} />
        </li>
      ))}
    </ol>

    <p class="mt-10 max-w-[44rem] mx-auto font-serif italic font-bold text-center text-lg sm:text-xl text-[var(--color-accent-deep)]">
      {t("about.languages_note")}
    </p>
  </Container>
</Section>
