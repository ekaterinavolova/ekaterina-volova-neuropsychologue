---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [
  {
    title: t("about.section2_step1_title"),
    desc: t("about.section2_step1_desc"),
  },
  {
    title: t("about.section2_step2_title"),
    desc: t("about.section2_step2_desc"),
  },
  {
    title: t("about.section2_step3_title"),
    desc: t("about.section2_step3_desc"),
  },
];

const timeline = [
  {
    dates: t("about.timeline_1_dates"),
    title: t("about.timeline_1_title"),
    desc: t("about.timeline_1_desc"),
  },
  {
    dates: t("about.timeline_2_dates"),
    title: t("about.timeline_2_title"),
    desc: t("about.timeline_2_desc"),
  },
  {
    dates: t("about.timeline_3_dates"),
    title: t("about.timeline_3_title"),
    desc: t("about.timeline_3_desc"),
  },
];

const contactHref = getLocalizedPath("/contact", lang);
---

{/* ─────────── HERO — typographique seul ─────────── */}
<header class="bg-[var(--color-paper)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 pt-10 sm:pt-14 pb-20 sm:pb-24">

    <p class="font-sans text-[0.8125rem] sm:text-sm uppercase tracking-[0.14em] text-[var(--color-accent-deep)] mb-12 sm:mb-16">
      {t("about.eyebrow")}
    </p>

    <div class="max-w-[52rem]">
      <h1
        class="font-serif italic text-[var(--color-ink)] leading-[0.98] tracking-[-0.025em]"
        style="font-size: clamp(2.75rem, 6vw + 1rem, 5.5rem);"
      >
        {t("home.h1")}
      </h1>

      <p class="mt-8 sm:mt-10 font-serif italic text-xl sm:text-2xl text-[var(--color-ink-soft)] leading-relaxed max-w-[40rem]">
        {t("home.lede")}
      </p>

      <p class="mt-6 font-serif italic text-[var(--color-ink-muted)] text-lg">
        Français
        <span class="mx-2.5 text-[var(--color-rule)]">·</span>
        Русский
        <span class="mx-2.5 text-[var(--color-rule)]">·</span>
        English
      </p>
    </div>
  </div>
</header>

{/* ─────────── 02 — Discipline & bilan ─────────── */}
<section id="discipline" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          02
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("about.section1_title").replace(/\s*\?$/, "")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        {/* Sous-section 1 : neuropsychologie */}
        <h2 class="font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("about.section1_title")}
        </h2>
        <p
          class="mt-6 font-sans text-[var(--color-ink-soft)] leading-[1.75]"
          style="text-align: justify; hyphens: auto;"
          lang={lang}
        >
          {t("about.section1_p1")}
        </p>

        {/* Sous-section 2 : bilan */}
        <h2 class="mt-16 font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("about.section2_title")}
        </h2>

        <div
          class="mt-6 space-y-5 font-sans text-[var(--color-ink-soft)] leading-[1.75]"
          style="text-align: justify; hyphens: auto;"
          lang={lang}
        >
          <p>{t("about.section2_p1")}</p>
          <p>{t("about.section2_p2")}</p>
        </div>

        {/* Étapes du bilan : liste numérotée éditoriale */}
        <div class="mt-12">
          <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-6">
            {t("about.section2_steps_intro").replace(/\s*:$/, "")}
          </p>
          <ol class="border-y border-[var(--color-rule)] divide-y divide-[var(--color-rule)]">
            {steps.map((step, idx) => (
              <li class="py-6 grid grid-cols-[3rem_minmax(0,1fr)] gap-6 items-baseline">
                <span class="font-serif italic text-[var(--color-ink-faint)] text-2xl tabular-nums">
                  {String(idx + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="font-serif text-[1.125rem] text-[var(--color-ink)] tracking-[-0.01em]">
                    {step.title}
                  </h3>
                  <p class="mt-2 font-sans text-[var(--color-ink-soft)] leading-relaxed">
                    {step.desc}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <p
          class="mt-12 font-sans text-[var(--color-ink-soft)] leading-[1.75]"
          style="text-align: justify; hyphens: auto;"
          lang={lang}
        >
          {t("about.section2_p3")}
        </p>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 03 — Formation et parcours ─────────── */}
<section id="parcours" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent-deep)] text-5xl sm:text-6xl leading-none tracking-tight">
          03
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          {t("about.section3_title")}
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <p
          class="font-serif italic text-[var(--color-ink-muted)] leading-relaxed text-[0.9375rem] border-l-2 border-[var(--color-rule)] pl-5"
          style="hyphens: auto;"
          lang={lang}
        >
          {t("about.section3_intro")}
        </p>

        <ol class="mt-12 border-y border-[var(--color-rule)] divide-y divide-[var(--color-rule)]">
          {timeline.map((entry) => (
            <li class="py-7 grid gap-x-10 gap-y-2 sm:grid-cols-[10rem_minmax(0,1fr)] items-baseline">
              <span class="font-serif italic text-[var(--color-accent-deep)] tabular-nums text-[0.9375rem] tracking-tight">
                {entry.dates}
              </span>
              <div>
                <h3 class="font-serif text-[1.125rem] text-[var(--color-ink)] tracking-[-0.01em]">
                  {entry.title}
                </h3>
                <p class="mt-1 font-sans text-[var(--color-ink-soft)] leading-relaxed">
                  {entry.desc}
                </p>
              </div>
            </li>
          ))}
        </ol>

        <p class="mt-10 font-serif italic text-[var(--color-ink-soft)] leading-relaxed">
          {t("about.languages_note")}
        </p>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 04 — CTA finale ─────────── */}
<section class="bg-[var(--color-accent-deep)] text-[var(--color-paper)] border-t border-[var(--color-accent-deep)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-20 sm:py-28">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside>
        <p class="font-serif italic text-[var(--color-paper)] text-5xl sm:text-6xl leading-none tracking-tight opacity-70">
          04
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <a
          href={contactHref}
          class="group inline-flex items-baseline gap-3 font-serif italic text-2xl sm:text-3xl text-[var(--color-paper)] no-underline border-b border-[var(--color-paper)]/70 pb-2 hover:border-[var(--color-paper)] transition-colors"
        >
          <span>{t("about.cta")}</span>
          <span class="font-sans not-italic text-xl transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>
    </div>
  </div>
</section>
