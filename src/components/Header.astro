---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";
import LangSwitcher from "./LangSwitcher.astro";
import Button from "./Button.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname.replace(/^\/(ru|en)/, "") || "/";

const navItems = [
  { href: "/", label: t("nav.home") },
  { href: "/a-propos", label: t("nav.about") },
  { href: "/prestations", label: t("nav.services") },
  { href: "/cabinet", label: t("nav.office") },
  { href: "/contact", label: t("nav.contact") },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}

const homeHref = getLocalizedPath("/", lang);
const contactHref = getLocalizedPath("/contact", lang);
---

<header class="sticky top-0 z-40 bg-[var(--color-paper)]/90 backdrop-blur-sm border-b border-[var(--color-rule-soft)]">
  <div class="max-w-[var(--container-wide)] mx-auto px-4 sm:px-8">
    <div class="grid grid-cols-[auto_1fr_auto] items-center h-16 sm:h-20 gap-3 sm:gap-6">

      {/* Gauche : bouton burger + langues */}
      <div class="flex items-center gap-1 sm:gap-2 -ml-2">
        <button
          type="button"
          id="menu-toggle"
          class="inline-flex items-center justify-center w-10 h-10 text-[var(--color-ink)] hover:text-[var(--color-accent-deep)] transition-colors"
          aria-label={t("header.menu_open")}
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="7" x2="19" y2="7"></line>
            <line x1="3" y1="11" x2="19" y2="11"></line>
            <line x1="3" y1="15" x2="19" y2="15"></line>
          </svg>
        </button>
        <LangSwitcher />
      </div>

      {/* Centre : nom (lien vers accueil) */}
      <a
        href={homeHref}
        class="justify-self-center no-underline group"
        aria-label="Ekaterina Volova"
      >
        <span class="font-serif italic text-base sm:text-lg md:text-xl tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-accent-deep)] transition-colors">
          Ekaterina Volova
        </span>
      </a>

      {/* Droite : bouton "Réserver" */}
      <div class="flex items-center justify-self-end">
        <Button href={contactHref} variant="secondary" size="md" class="!px-4 sm:!px-5 !py-2 text-[0.8125rem] sm:text-[0.9375rem]">
          <span class="sm:hidden">{t("cta.book_short")}</span>
          <span class="hidden sm:inline">{t("cta.book")}</span>
        </Button>
      </div>
    </div>

    {/* Drawer : nav links + langues (mobile) */}
    <div
      id="site-menu"
      class="hidden border-t border-[var(--color-rule-soft)] py-4"
      aria-hidden="true"
    >
      <nav aria-label={t("nav.home")} class="flex flex-col gap-1">
        {
          navItems.map((item) => {
            const href = getLocalizedPath(item.href, lang);
            const active = isActive(item.href);
            return (
              <a
                href={href}
                class:list={[
                  "px-3 py-3 text-base no-underline transition-colors rounded-[var(--radius-sm)]",
                  active
                    ? "text-[var(--color-ink)] font-medium bg-[var(--color-paper-warm)]"
                    : "text-[var(--color-ink-soft)] hover:bg-[var(--color-paper-warm)]",
                ]}
                aria-current={active ? "page" : "false"}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("site-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      menu.setAttribute("aria-hidden", String(isOpen));
      menu.classList.toggle("hidden");
    });
  }
</script>
