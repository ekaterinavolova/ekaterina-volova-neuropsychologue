---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";
import LangSwitcher from "./LangSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname.replace(/^\/(ru|en)/, "") || "/";

const navItems = [
  { href: "/", label: t("nav.home") },
  { href: "/a-propos", label: t("nav.about") },
  { href: "/prestations", label: t("nav.services") },
  { href: "/cabinet", label: t("nav.office") },
  { href: "/contact", label: t("nav.contact") },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(href + "/");
}

const homeHref = getLocalizedPath("/", lang);
---

<header class="sticky top-0 z-40 bg-[var(--color-paper)]/95 backdrop-blur-sm border-b border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-6">

      {/* Nom — signature de livre */}
      <a
        href={homeHref}
        class="no-underline group shrink-0"
        aria-label="Ekaterina Volova"
      >
        <span class="font-serif italic text-base sm:text-lg tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-accent-deep)] transition-colors">
          Ekaterina Volova
        </span>
      </a>

      {/* Nav desktop — uppercase tracking modéré, touch target élargi */}
      <nav aria-label={t("nav.home")} class="hidden lg:flex items-center gap-6 text-[0.8125rem] uppercase tracking-[0.14em]">
        {
          navItems.map((item) => {
            const href = getLocalizedPath(item.href, lang);
            const active = isActive(item.href);
            return (
              <a
                href={href}
                class:list={[
                  "py-2 px-1 no-underline transition-colors",
                  active
                    ? "text-[var(--color-ink)]"
                    : "text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]",
                ]}
                aria-current={active ? "page" : "false"}
              >
                {item.label}
              </a>
            );
          })
        }
      </nav>

      {/* Lang switcher + burger (mobile/tablette) */}
      <div class="flex items-center gap-5 shrink-0">
        <LangSwitcher class="hidden sm:flex" />
        <button
          type="button"
          id="menu-toggle"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 text-[var(--color-ink)] hover:text-[var(--color-accent-deep)] transition-colors"
          aria-label={t("header.menu_open")}
          aria-expanded="false"
          aria-controls="site-menu"
        >
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" aria-hidden="true">
            <line x1="3" y1="8" x2="19" y2="8"></line>
            <line x1="3" y1="14" x2="19" y2="14"></line>
          </svg>
        </button>
      </div>
    </div>

    {/* Drawer mobile/tablette : nav verticale + langs */}
    <div
      id="site-menu"
      class="hidden lg:hidden border-t border-[var(--color-rule-soft)] py-5"
      aria-hidden="true"
    >
      <nav aria-label={t("nav.home")} class="flex flex-col gap-1">
        {
          navItems.map((item) => {
            const href = getLocalizedPath(item.href, lang);
            const active = isActive(item.href);
            return (
              <a
                href={href}
                class:list={[
                  "px-2 py-3.5 text-[0.875rem] uppercase tracking-[0.14em] no-underline transition-colors",
                  active
                    ? "text-[var(--color-ink)]"
                    : "text-[var(--color-ink-muted)] hover:text-[var(--color-ink)]",
                ]}
                aria-current={active ? "page" : "false"}
              >
                {item.label}
              </a>
            );
          })
        }
        <div class="sm:hidden pt-4 mt-3 border-t border-[var(--color-rule-soft)]">
          <LangSwitcher class="px-2" />
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("site-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      menu.setAttribute("aria-hidden", String(isOpen));
      menu.classList.toggle("hidden");
    });
  }
</script>
