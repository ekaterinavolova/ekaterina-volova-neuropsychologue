---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const bilans = [
  {
    title: t("prestations.bilan_1"),
    desc: t("prestations.bilan_1_desc"),
    price: t("prestations.bilan_1_price"),
  },
  {
    title: t("prestations.bilan_2"),
    desc: t("prestations.bilan_2_desc"),
    price: t("prestations.bilan_2_price"),
  },
  {
    title: t("prestations.bilan_3"),
    desc: t("prestations.bilan_3_desc"),
    price: t("prestations.bilan_3_price"),
  },
  {
    title: t("prestations.bilan_4"),
    desc: t("prestations.bilan_4_desc"),
    price: t("prestations.bilan_4_price"),
  },
];

const contactHref = getLocalizedPath("/contact", lang);
---

{/* ─────────── HERO ─────────── */}
<header class="bg-[var(--color-paper)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 pt-10 sm:pt-14 pb-20 sm:pb-24">

    <p class="font-sans text-[0.8125rem] sm:text-sm uppercase tracking-[0.14em] text-[var(--color-accent)] mb-12 sm:mb-16">
      {t("nav.services")}
    </p>

    <div class="max-w-[52rem]">
      <h1
        class="font-serif italic text-[var(--color-ink)] leading-[0.98] tracking-[-0.025em]"
        style="font-size: clamp(2.75rem, 6vw + 1rem, 5.5rem);"
      >
        {t("home.services.title")}
      </h1>

      <p class="mt-8 sm:mt-10 font-serif italic text-xl sm:text-2xl text-[var(--color-ink-soft)] leading-relaxed max-w-[40rem]">
        {t("cta.book")}
      </p>
    </div>
  </div>
</header>

{/* ─────────── 01 — Entretien initial ─────────── */}
<section id="entretien" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent)] text-5xl sm:text-6xl leading-none tracking-tight">
          01
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          Entretien
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <h2 class="font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("prestations.entretien_title")}
        </h2>

        <ul class="mt-10 divide-y divide-[var(--color-rule)] border-y border-[var(--color-rule)]">
          <li class="py-8 sm:py-10 grid gap-x-10 gap-y-3 sm:grid-cols-[3rem_minmax(0,1fr)_auto] items-baseline">
            <span class="font-serif italic text-[var(--color-ink-faint)] text-2xl tabular-nums">
              01
            </span>
            <div>
              <h3 class="font-serif text-[var(--color-ink)] text-[1.375rem] tracking-[-0.012em]">
                {t("prestations.entretien_title")}
              </h3>
              <p class="mt-3 font-sans text-[var(--color-ink-soft)] leading-relaxed max-w-[36rem] text-justify">
                {t("prestations.entretien_desc")}
              </p>
            </div>
            <span class="font-sans text-sm tabular-nums text-[var(--color-accent-deep)] sm:text-right whitespace-nowrap font-medium">
              {t("prestations.entretien_price")}
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 03 — Bilans neuropsychologiques ─────────── */}
<section id="bilans" class="bg-[var(--color-paper)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent)] text-5xl sm:text-6xl leading-none tracking-tight">
          02
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          Bilans
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <h2 class="font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("prestations.bilans_title")}
        </h2>

        <ul class="mt-10 divide-y divide-[var(--color-rule)] border-y border-[var(--color-rule)]">
          {bilans.map((b, idx) => (
            <li class="py-8 sm:py-10 grid gap-x-10 gap-y-3 sm:grid-cols-[3rem_minmax(0,1fr)_auto] items-baseline">
              <span class="font-serif italic text-[var(--color-ink-faint)] text-2xl tabular-nums">
                {String(idx + 1).padStart(2, "0")}
              </span>
              <div>
                <h3 class="font-serif text-[var(--color-ink)] text-[1.375rem] tracking-[-0.012em]">
                  {b.title}
                </h3>
                <p class="mt-3 font-sans text-[var(--color-ink-soft)] leading-relaxed max-w-[36rem] text-justify">
                  {b.desc}
                </p>
              </div>
              <span class="font-sans text-sm tabular-nums text-[var(--color-accent-deep)] sm:text-right whitespace-nowrap font-medium">
                {b.price}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

{/* ─────────── 03 — Remediation ─────────── */}
<section id="remediation" class="bg-[var(--color-paper-warm)] border-t border-[var(--color-rule-soft)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-24 sm:py-32">
    <div class="grid gap-10 md:gap-16 md:grid-cols-[10rem_minmax(0,1fr)]">

      <aside class="md:pt-3">
        <p class="font-serif italic text-[var(--color-accent)] text-5xl sm:text-6xl leading-none tracking-tight">
          03
        </p>
        <p class="mt-4 font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)]">
          Remédiation
        </p>
      </aside>

      <div class="max-w-[42rem]">
        <h2 class="font-serif italic text-[1.625rem] sm:text-3xl leading-tight text-[var(--color-ink)] tracking-[-0.012em]">
          {t("prestations.remediation_title")}
        </h2>

        <ul class="mt-10 divide-y divide-[var(--color-rule)] border-y border-[var(--color-rule)]">
          <li class="py-8 sm:py-10 grid gap-x-10 gap-y-3 sm:grid-cols-[3rem_minmax(0,1fr)_auto] items-baseline">
            <span class="font-serif italic text-[var(--color-ink-faint)] text-2xl tabular-nums">
              01
            </span>
            <div>
              <h3 class="font-serif text-[var(--color-ink)] text-[1.375rem] tracking-[-0.012em]">
                {t("prestations.remediation_title")}
              </h3>
              <p class="mt-3 font-sans text-[var(--color-ink-soft)] leading-relaxed max-w-[36rem] text-justify">
                {t("prestations.remediation_desc")}
              </p>
            </div>
            <span class="font-sans text-sm tabular-nums text-[var(--color-accent-deep)] sm:text-right whitespace-nowrap font-medium">
              {t("prestations.remediation_price")}
            </span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

