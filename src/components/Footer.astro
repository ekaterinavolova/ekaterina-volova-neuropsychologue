---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "~/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const currentYear = new Date().getFullYear();
const contactHref = getLocalizedPath("/contact", lang);
const legalHref = getLocalizedPath("/mentions-legales", lang);
---

<footer class="mt-auto bg-[var(--color-paper-warm)] border-t border-[var(--color-rule)]">
  <div class="mx-auto max-w-[var(--container-wide)] px-6 sm:px-8 py-16 sm:py-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-3">

      {/* Colonne 1 : signature praticienne */}
      <div>
        <p class="font-serif italic text-xl text-[var(--color-ink)] tracking-tight">
          Ekaterina Volova
        </p>
        <p class="mt-2 font-sans text-[0.8125rem] text-[var(--color-ink-soft)] leading-relaxed">
          {t("footer.profession")}
        </p>
        <p class="mt-5 font-mono text-[0.8125rem] tabular-nums tracking-tight text-[var(--color-ink-muted)]">
          {t("footer.rpps")}
        </p>
      </div>

      {/* Colonne 2 : cabinet */}
      <div>
        <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-4">
          {t("footer.cabinet_label")}
        </p>
        <address class="not-italic font-serif text-[var(--color-ink)] leading-relaxed">
          Cabinet Via SANA Parmentier<br />
          4 rue Pierre Levée<br />
          75011 Paris
        </address>
        <p class="mt-4 font-serif italic text-[0.9375rem] text-[var(--color-ink-muted)]">
          {t("footer.opening_note")}
        </p>
      </div>

      {/* Colonne 3 : prise de contact */}
      <div>
        <p class="font-sans text-[0.8125rem] uppercase tracking-[0.16em] text-[var(--color-ink-muted)] mb-4">
          {t("footer.contact_label")}
        </p>
        <a
          href={contactHref}
          class="font-serif italic text-lg text-[var(--color-ink)] no-underline border-b border-[var(--color-ink)] pb-0.5 hover:text-[var(--color-accent-deep)] hover:border-[var(--color-accent-deep)] transition-colors"
        >
          {t("cta.contact")}
        </a>
      </div>
    </div>

    {/* Colophon de livre — discret, langue-agnostique */}
    <div class="mt-16 sm:mt-20 pt-6 border-t border-[var(--color-rule)]">
      <p class="text-center font-serif italic text-[0.8125rem] text-[var(--color-ink-faint)] tracking-tight">
        Paris
        <span class="mx-2.5 text-[var(--color-rule)]">·</span>
        Source Serif 4 &amp; Inter
        <span class="mx-2.5 text-[var(--color-rule)]">·</span>
        <span class="tabular-nums">MMXXVI</span>
      </p>

      <div class="mt-5 flex flex-col sm:flex-row justify-between items-center gap-2 text-[0.8125rem] uppercase tracking-[0.14em] text-[var(--color-ink-muted)]">
        <p>
          © {currentYear} Ekaterina Volova
        </p>
        <a
          href={legalHref}
          class="no-underline hover:text-[var(--color-ink)] transition-colors"
        >
          {t("footer.legal_link")}
        </a>
      </div>
    </div>
  </div>
</footer>
