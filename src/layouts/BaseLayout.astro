---
import "~/styles/global.css";
import { getLangFromUrl, useTranslations, getAlternateUrls } from "~/i18n/utils";
import type { Lang } from "~/i18n/ui";
import { ui } from "~/i18n/ui";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Chemin canonique relatif (sans préfixe de langue), ex: "/contact" ou "/" */
  canonicalPath?: string;
  /** Cache le header/footer (pour pages d'erreur ou layout custom) */
  bare?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageTitle = Astro.props.title ?? ui[lang]["site.title"];
const pageDescription = Astro.props.description ?? ui[lang]["site.description"];
const canonicalPath = Astro.props.canonicalPath ?? "/";
const bare = Astro.props.bare ?? false;

const alternates = getAlternateUrls(canonicalPath, Astro.site!);
const canonical = alternates[lang];

const htmlLangAttr: Record<Lang, string> = {
  fr: "fr-FR",
  ru: "ru-RU",
  en: "en-US",
};

const siteUrl = Astro.site!.toString().replace(/\/$/, "");
const ogImageUrl = `${siteUrl}/og-image.jpg`;

const schemaOrg = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Ekaterina Volova",
  alternateName: "Екатерина Волова",
  description: ui.fr["site.description"],
  url: siteUrl,
  telephone: "+33666074254",
  email: "volova.neuropsy@gmail.com",
  image: ogImageUrl,
  priceRange: "65€ - 550€",
  currenciesAccepted: "EUR",
  address: {
    "@type": "PostalAddress",
    streetAddress: "14 rue Nicolo",
    addressLocality: "Paris",
    postalCode: "75116",
    addressCountry: "FR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 48.858,
    longitude: 2.278,
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "09:30",
    closes: "18:30",
  },
  areaServed: {
    "@type": "City",
    name: "Paris",
  },
  knowsLanguage: ["fr", "ru", "en"],
});
---

<!doctype html>
<html lang={htmlLangAttr[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr-FR" href={alternates.fr} />
    <link rel="alternate" hreflang="ru-RU" href={alternates.ru} />
    <link rel="alternate" hreflang="en-US" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.fr} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLangAttr[lang].replace("-", "_")} />
    <meta property="og:site_name" content="Ekaterina Volova" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#1E2D3F" />

    <Fragment set:html={`<script type="application/ld+json">${schemaOrg}</script>`} />
  </head>
  <body class="min-h-screen flex flex-col">
    {!bare && <Header />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
  </body>
</html>
